        _test_symbols_and_graph(root)
        _test_budget_is_honest(root)
        _test_log_summary_length(root)
        _test_activity_tail(root)
        _test_focus(root)
        _test_slice(root)
        _test_misc(root)
        _test_git_integration(root)
        _test_dump_is_live(root)
        _test_dump_file_and_git_init(root)
        _test_cache_pruning(root)
        _test_tasks(root)
        _test_vectorized_pagerank()
        _test_polyglot_graph(root)
        _test_staleness_scanner(root)
        _test_debt_system(root)
        _test_atomic_locking_and_concurrency(root)
    _test_complexity_budget()
    print("Self-test passed successfully.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="mimori", description="Zero-daemon Agent Context, Memory, & Activity Tracker")
    parser.add_argument("--version", action="version", version=f"mimori {__version__}")
    parser.add_argument("--test", action="store_true", help="Run self-tests and exit")
    subparsers = parser.add_subparsers(dest="command", help="Sub-command to execute")

    subparsers.add_parser("init", help="Initialize .mimori/ directory with templates and repo map")

    map_parser = subparsers.add_parser("map", help="Scan repository and generate ranked symbol map")
    map_parser.add_argument("--stdout", action="store_true", help="Print map to stdout instead of file")
    budget_help = (f"Character budget: a number, 'default', or {'/'.join(BUDGET_PRESETS)} "
                   f"({', '.join(f'{k}={v}' for k, v in BUDGET_PRESETS.items())}). "
                   f"Env: MIMORI_BUDGET.")
    map_parser.add_argument("--budget", default=None, help=budget_help)
    focus_help = ("Comma-separated files/substrings to pull into full detail with their "
                  "import-graph neighbors; everything else collapses. Env: MIMORI_FOCUS.")
    map_parser.add_argument("--focus", default=None, help=focus_help)

    dump_parser = subparsers.add_parser(
        "dump", help="Print high-signal context snapshot (state, memory, decisions, map, activity)")
    dump_parser.add_argument("--budget", default=None, help=budget_help)
    dump_parser.add_argument("--focus", default=None,
                             help="Comma-separated files/substrings to pull into full detail "
                                  "(with their import-graph neighbors); env: MIMORI_FOCUS.")
    dump_parser.add_argument(
        "--file", "-o", "--out",
        nargs="?",
        const="",
        default=None,
        help="Write snapshot to user temp file ($XDG_RUNTIME_DIR/mimori/ctx-<repo>-<commit>.md) or custom path",
    )

    log_parser = subparsers.add_parser("log", help="Append a repository action entry to .mimori/activity.jsonl")
    log_parser.add_argument("--action", required=True, help="Short action identifier (e.g. 'refactor-auth', 'benchmark-sweep')")
    log_parser.add_argument("--summary", required=True, help="High-level 1-line caveman summary of action (<160 chars)")
    log_parser.add_argument("--files", default="", help="Comma-separated list of modified or inspected files")

    hist_parser = subparsers.add_parser("history", help="Show recent logged repository actions")
    hist_parser.add_argument("--limit", type=int, default=10, help="Number of records to show (default: 10)")

    clean_parser = subparsers.add_parser("clean", help="Clean stale or expired context snapshots from user temp directory")
    clean_parser.add_argument("--all", action="store_true", help="Remove all cached context snapshots unconditionally")

    todo_parser = subparsers.add_parser("todo", help="Track tasks, in-progress work, and todos (.mimori/tasks.md)")
    todo_parser.add_argument("action", nargs="?", default="list", help="Action: list, add, start, done, reopen, rm")
    todo_parser.add_argument("target", nargs="*", default=[], help="Task description or ID/search term")
    todo_parser.add_argument("--prio", "-p", choices=["high", "med", "low", "urgent"], default=None, help="Task priority")
    todo_parser.add_argument("--tag", "-t", action="append", default=[], help="Tag(s) for task")
    todo_parser.add_argument("--status", "-s", choices=["todo", "in_progress", "done", "idea", "all"], default="all", help="Filter tasks by status")
    todo_parser.add_argument("--idea", action="store_true", help="Add as a future idea/backlog item")
    todo_parser.add_argument("--start", action="store_true", help="Add directly to In Progress")
    todo_parser.add_argument("--plain", action="store_true", help="Output plain text without ANSI colors")

    task_parser = subparsers.add_parser("task", help="Alias for 'mimori todo'")
    task_parser.add_argument("action", nargs="?", default="list", help="Action: list, add, start, done, reopen, rm")
    task_parser.add_argument("target", nargs="*", default=[], help="Task description or ID/search term")
    task_parser.add_argument("--prio", "-p", choices=["high", "med", "low", "urgent"], default=None, help="Task priority")
    task_parser.add_argument("--tag", "-t", action="append", default=[], help="Tag(s) for task")
    task_parser.add_argument("--status", "-s", choices=["todo", "in_progress", "done", "idea", "all"], default="all", help="Filter tasks by status")
    task_parser.add_argument("--idea", action="store_true", help="Add as a future idea/backlog item")
    task_parser.add_argument("--start", action="store_true", help="Add directly to In Progress")
    task_parser.add_argument("--plain", action="store_true", help="Output plain text without ANSI colors")

    idea_parser = subparsers.add_parser("idea", help="Manage future ideas and backlog proposals")
    idea_parser.add_argument("action", nargs="?", default="list", help="Action: list, add, promote, rm")
    idea_parser.add_argument("target", nargs="*", default=[], help="Idea description or ID/search term")
    idea_parser.add_argument("--tag", "-t", action="append", default=[], help="Tag(s) for idea")
    idea_parser.add_argument("--plain", action="store_true", help="Output plain text without ANSI colors")

    slice_parser = subparsers.add_parser("slice", help="Deterministic context slice for a file or symbol with 1-hop lineage")
    slice_parser.add_argument("target", nargs="+", help="Target path or symbol (e.g. 'file.py:sym' or 'file.py')")
    slice_parser.add_argument("--lines", "-l", type=int, default=100, help="Max source lines to render (default: 100)")

    debt_parser = subparsers.add_parser("debt", help="Scan, sync, and validate ponytail: technical debt markers")
    debt_parser.add_argument("action", nargs="?", default="list", choices=["list", "sync", "check"], help="Action: list, sync with memory.md, or check for CI")
    debt_parser.add_argument("--plain", action="store_true", help="Output plain text without ANSI colors")

    args = parser.parse_args()

    if args.test:
        return run_self_test()

    if not args.command:
        parser.print_help()
        return 1

    handlers = {
        "init": cmd_init,
        "map": cmd_map,
        "slice": cmd_slice,
        "dump": cmd_dump,
        "log": cmd_log,
        "history": cmd_history,
        "clean": cmd_clean,
        "todo": cmd_todo,
        "task": cmd_todo,
        "idea": cmd_idea,
        "debt": cmd_debt,
    }
    return handlers[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
