def collect_repo(root: Path) -> Dict[str, FileInfo]:
    files = list_files(root)
    infos: Dict[str, FileInfo] = {}

    if len(files) > 40:
        max_workers = min(32, (os.cpu_count() or 1) + 4)
        with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
            future_to_rel = {executor.submit(analyze_file, root, rel): rel for rel in files}
            for fut in concurrent.futures.as_completed(future_to_rel):
                rel = future_to_rel[fut]
                try:
                    info = fut.result()
                    if info is not None:
                        infos[rel] = info
                except Exception:
                    pass
    else:
        for rel in files:
            info = analyze_file(root, rel)
            if info is not None:
                infos[rel] = info

    paths = set(infos)
    py_index = build_python_index(paths)
    go_mod = parse_go_module(root, paths)
    cargo_crate = parse_cargo_crate(root, paths)
    build_import_graph(infos, py_index, load_path_aliases(root, paths), go_mod=go_mod, cargo_crate=cargo_crate)
    detect_entry_points(root, infos, py_index)
    for rel, count in get_churn(root).items():
        if rel in infos:
            infos[rel].churn = count

    try:
        pr = compute_pagerank(infos)
        for p, v in pr.items():
            if p in infos:
                infos[p].pagerank = v
    except Exception as e:
        _debug(f"pagerank failed (rankings fall back to in-degree): {e!r}")
    return infos


def _combined_score(info: FileInfo, n: int, weight: float = 4.0) -> float:
    """4*in_degree + weight*pr*N + churn + entry + symbols — additive, not replacement."""
    pr_bonus = info.pagerank * n * weight if info.pagerank > 0 and n > 0 else 0.0
    return (4 * info.in_degree) + pr_bonus + min(info.churn, 10) + (6 if info.entry else 0) + (1 if info.symbols else 0)


def _render_symbol(lineno: int, depth: int, text: str) -> str:
    return f"  :{str(lineno).ljust(5)}{'  ' * depth}{text}"


GENERIC_STEMS = {"index", "page", "layout", "route", "main", "mod", "__init__"}


def _importer_label(path: str) -> str:
    """Name an importing file. Bare stems collide in route-based projects, where
    a dozen distinct files are all called `page` — qualify those with their dir."""
    p = Path(path)
    if p.stem in GENERIC_STEMS and p.parent.name:
        return f"{p.parent.name}/{p.stem}"
    return p.stem


def _file_header(info: FileInfo) -> str:
    bits = []
    if info.lines:
        bits.append(f"{info.lines} ln")
    if info.importers:
        names = sorted({_importer_label(p) for p in info.importers})
        shown = ", ".join(names[:4])
        if len(names) > 4:
            shown += f", +{len(names) - 4}"
        bits.append(f"← {shown}")
    if info.churn:
        bits.append(f"{info.churn} commit{'s' if info.churn != 1 else ''}/{CHURN_DAYS}d")
    if info.entry:
        bits.append("entry point")
    suffix = f" · {' · '.join(bits)}" if bits else ""
    return f"`{info.path}`{suffix}"


def _render_detail(info: FileInfo) -> str:
    out = [_file_header(info)]
    if info.doc:
        out.append(f'  "{info.doc}"')
    for lineno, depth, text in info.symbols[:12]:
        out.append(_render_symbol(lineno, depth, text))
    if len(info.symbols) > 12:
        out.append(f"  ... +{len(info.symbols) - 12} more symbols")
    return "\n".join(out)


def _render_compact(info: FileInfo) -> str:
    tops = [f":{ln} {txt.split('(')[0]}" for ln, depth, txt in info.symbols if depth == 0][:6]
    tail = f" · {' · '.join(tops)}" if tops else ""
    return f"{_file_header(info)}{tail}"


def _group_dirs(infos: List[FileInfo], top_level_only: bool) -> List[str]:
    groups: Dict[str, List[FileInfo]] = {}
    for info in infos:
        parent = Path(info.path).parent
        key = (parent.parts[0] if top_level_only and parent.parts else parent.as_posix())
        groups.setdefault("." if key == "." else key.rstrip("/") + "/", []).append(info)

    out = []
    for parent in sorted(groups):
        members = groups[parent]
        exts = sorted({Path(m.path).suffix or "(no ext)" for m in members})
        if len(members) <= 3 and not top_level_only:
            out.append(f"- `{parent}` — " + ", ".join(f"`{Path(m.path).name}`" for m in members))
        else:
            out.append(f"- `{parent}` — {len(members)} files ({', '.join(exts[:4])})")
    return out


def _collapse_dirs(infos: List[FileInfo], limit: int) -> List[str]:
    """Summarise collapsed files, rolling up to top-level dirs if the list is itself
    too long — an unbudgeted tail would quietly blow the caller's budget."""
    lines = _group_dirs(infos, top_level_only=False)
    if sum(len(l) + 1 for l in lines) <= limit:
        return lines
    return _group_dirs(infos, top_level_only=True)


def generate_repo_map(root: Path, budget: int = MAP_BUDGET_DEFAULT,
                      focus: Optional[List[str]] = None) -> str:
    infos = collect_repo(root)
    total = len(infos)
    total_lines = sum(i.lines for i in infos.values())

    # Rank by combined PageRank + in_degree (additive weight 4 keeps old order, adds transitive boost)
    n = len(infos)
    ranked = sorted(infos.values(), key=lambda i: (-_combined_score(i, n), i.path))

    # Task conditioning: `focus` pulls matched files and their import-graph
    # neighbors into full detail and collapses everything else to a directory
    # summary. The map stops being a static ranking and becomes "start here".
    focused: Set[str] = set()
    neighbors: Set[str] = set()
    if focus:
        tokens = [t.lower() for t in focus if t]
        for info in infos.values():
            if any(t in info.path.lower() for t in tokens):
                focused.add(info.path)
        for path in focused:
            info = infos[path]
            neighbors |= info.importers | info.depends_on
        neighbors -= focused

    head = ["# Repository Map", ""]
    if focus:
        head.append(
            f"{total} files · focus: {', '.join(focus)} — full detail for "
            f"{len(focused)} matched file(s) and {len(neighbors)} import-graph "
            f"neighbor(s); other files summarized by directory."
        )
    else:
        head.append(
            f"{total} files · {total_lines} lines of parsed code · "
            f"ranked by PageRank+in-degree + {CHURN_DAYS}d churn + entry points"
        )

    entries = [i for i in ranked if i.entry]
    if entries and not focus:
        head += ["", "## Entry points", ""]
        head += [f"- `{i.path}`" for i in entries[:10]]
        if len(entries) > 10:
            head.append(f"- _... +{len(entries) - 10} more entry points (ranked; see the map below)_")

    core_blocks: List[str] = []
    support_blocks: List[str] = []
    collapsed: List[FileInfo] = []
    detailed = 0
    used = sum(len(l) + 1 for l in head)
    truncated = False

    if focus:
        detail_set = focused | neighbors
        order = [infos[p] for p in sorted(detail_set, key=lambda p: (-_combined_score(infos[p], n), p))]
    else:
        detail_set = set()
        order = ranked

    for info in order:
        # Focused files always render detail. Without focus, only entry points
        # and widely-imported files do; a symbol-free leaf earns a compact line
        # at most (its importer list is the point), otherwise it collapses.
        wants_detail = info.path in focused or (not focus and (info.entry or info.in_degree >= 2))
        if not wants_detail and not info.symbols and info.in_degree < 2:
            collapsed.append(info)
            continue
        block = _render_detail(info) if wants_detail else _render_compact(info)
        if truncated or used + len(block) + 2 > budget - COLLAPSE_RESERVE:
            truncated = True
            collapsed.append(info)
            continue
        used += len(block) + 2
        (core_blocks if info.path in detail_set or wants_detail else support_blocks).append(block)
        detailed += 1

    if focus:
        # Everything outside the task neighborhood is summarized, never detailed.
        collapsed.extend(infos[p] for p in infos if p not in detail_set)

    out = list(head)
    if core_blocks:
        out += ["", "## Core modules", ""]
        out.append("\n\n".join(core_blocks))
    if support_blocks:
        out += ["", "## Supporting files", ""]
        out.append("\n\n".join(support_blocks))
    if collapsed:
        out += ["", "## Other files", ""]
        out += _collapse_dirs(collapsed, COLLAPSE_RESERVE)

    out += ["", f"_Detailed {detailed} of {total} files; {len(collapsed)} collapsed above._"]
    if truncated:
        out.append(
            f"_Output hit the {budget}-char budget — lower-ranked files were collapsed, "
            f"not dropped. Raise with `mimori map --budget N`, or use Grep for exact locations._"
        )
    return "\n".join(out)


