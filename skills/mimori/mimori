class FileInfo:
    """One repo file: its symbols, its imports, and the signals used to rank it."""

    def __init__(self, path: str, size: int):
        self.path = path
        self.size = size
        self.lines = 0
        self.doc: Optional[str] = None
        self.symbols: List[Tuple[int, int, str]] = []  # (lineno, depth, text)
        self.imports: List[tuple] = []
        self.importers: Set[str] = set()
        self.depends_on: Set[str] = set()
        self.churn = 0
        self.entry = False
        self.executable = False
        self.pagerank: float = 0.0

    @property
    def in_degree(self) -> int:
        return len(self.importers)

    @property
    def score(self) -> int:
        return (4 * self.in_degree) + min(self.churn, 10) + (6 if self.entry else 0) + (1 if self.symbols else 0)


def _elide(text: str, limit: int) -> str:
    """Truncate visibly, so a cut signature never reads as a complete one."""
    return text if len(text) <= limit else text[:limit - 1] + "…"


def _fmt_signature(node, drop_self: bool) -> str:
    try:
        params = ast.unparse(node.args)
    except Exception:
        params = "..."
    if drop_self:
        for prefix in ("self, ", "cls, "):
            if params.startswith(prefix):
                params = params[len(prefix):]
                break
        if params in ("self", "cls"):
            params = ""
    sig = f"{node.name}({params})"
    if node.returns is not None:
        with contextlib.suppress(Exception):
            sig += f" -> {ast.unparse(node.returns)}"
    prefix = "async " if isinstance(node, ast.AsyncFunctionDef) else ""
    return _elide(prefix + sig, 88)


def _first_doc_line(node) -> Optional[str]:
    try:
        doc = ast.get_docstring(node)
    except Exception:
        return None
    if not doc:
        return None
    return doc.strip().splitlines()[0].strip()[:100]


def parse_python(content: str) -> Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]:
    """Symbols with signatures + line numbers, plus import specs for the graph."""
    symbols: List[Tuple[int, int, str]] = []
    imports: List[tuple] = []
    try:
        tree = ast.parse(content)
    except Exception:
        # Unparseable (syntax error, different python dialect): degrade to names only.
        for i, line in enumerate(content.splitlines(), 1):
            m = re.match(r"^(?:class|def|async def)\s+([A-Za-z0-9_]+)", line.strip())
            if m:
                symbols.append((i, 0, m.group(0)))
        return None, symbols, imports

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            imports.extend(("py_abs", a.name) for a in node.names)
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                if node.module:
                    imports.append(("py_rel", node.level, node.module))
                else:
                    imports.extend(("py_rel", node.level, a.name) for a in node.names)
            elif node.module:
                imports.append(("py_abs", node.module))

    for node in tree.body:
        if isinstance(node, ast.ClassDef):
            symbols.append((node.lineno, 0, f"class {node.name}"))
            for sub in node.body:
                if isinstance(sub, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    if sub.name.startswith("_") and sub.name != "__init__":
                        continue
                    symbols.append((sub.lineno, 1, _fmt_signature(sub, drop_self=True)))
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            symbols.append((node.lineno, 0, _fmt_signature(node, drop_self=False)))

    return _first_doc_line(tree), symbols, imports


GENERIC_PATTERNS = {
    ".js": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class)\s+([A-Za-z0-9_$]+)",
            r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".jsx": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class)\s+([A-Za-z0-9_$]+)",
             r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".ts": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class|interface|type|enum)\s+([A-Za-z0-9_$]+)",
            r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".tsx": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class|interface|type|enum)\s+([A-Za-z0-9_$]+)",
             r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".go": [r"^func\s+(?:\([^\)]+\)\s+)?([A-Za-z0-9_]+)", r"^type\s+([A-Za-z0-9_]+)\s+(?:struct|interface)"],
    ".rs": [r"^(?:pub\s+)?(?:fn|struct|enum|trait|type)\s+([A-Za-z0-9_]+)"],
    ".c": [r"^[A-Za-z0-9_ *]+\s+([A-Za-z0-9_]+)\s*\([^)]*\)\s*\{"],
    ".cpp": [r"^(?:class|struct)\s+([A-Za-z0-9_]+)", r"^[A-Za-z0-9_ *:]+\s+([A-Za-z0-9_]+)\s*\([^)]*\)\s*\{"],
    ".h": [r"^(?:class|struct)\s+([A-Za-z0-9_]+)", r"^[A-Za-z0-9_ *:]+\s+([A-Za-z0-9_]+)\s*\([^)]*\);"],
}

JS_IMPORT_RE = re.compile(r"""(?:from|require\()\s*['"]([^'"]+)['"]""")


def parse_generic(content: str, ext: str) -> Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]:
    symbols: List[Tuple[int, int, str]] = []
    imports: List[tuple] = []
    regexes = [re.compile(p) for p in GENERIC_PATTERNS.get(ext, [])]

    for i, raw in enumerate(content.splitlines(), 1):
        line = raw.strip()
        if ext in JS_EXTS:
            # Keep bare specifiers too: they may be tsconfig path aliases (`@/lib/x`),
            # which in an aliased project vastly outnumber relative imports.
            imports.extend(("js_spec", spec) for spec in JS_IMPORT_RE.findall(line))
        for c in regexes:
            if c.match(line):
                symbols.append((i, 0, _elide(line.rstrip("{ ").strip(), 88)))
                break
    return None, symbols, imports


SHEBANG_EXTS = {"python": ".py", "node": ".js", "deno": ".ts", "bun": ".ts"}


def _sniff_shebang(full: Path) -> Optional[str]:
    """Map an extensionless script to a parser via its shebang."""
    try:
        with open(full, "rb") as f:
            first = f.readline(200).decode("utf-8", errors="ignore")
    except OSError:
        return None
    if not first.startswith("#!"):
        return None
    for name, ext in SHEBANG_EXTS.items():
        if name in first:
            return ext
    return None


def analyze_file(root: Path, rel: str) -> Optional[FileInfo]:
    full = root / rel
    try:
        st = full.stat()
    except OSError:
        return None
    info = FileInfo(rel, st.st_size)
    info.executable = bool(st.st_mode & 0o111)

    ext = Path(rel).suffix.lower()
    if ext not in CODE_EXTS and info.executable:
        ext = _sniff_shebang(full) or ext  # extensionless scripts in bin/ are common
    if ext not in CODE_EXTS or st.st_size > MAX_PARSE_BYTES:
        return info

    try:
        content = full.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return info

    info.lines = content.count("\n") + 1
    if ext == ".py":
        info.doc, info.symbols, info.imports = parse_python(content)
    else:
        info.doc, info.symbols, info.imports = parse_generic(content, ext)
    return info


