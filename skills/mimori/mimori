# ponytail: 31 legacy functions still exceed the 10-CC ceiling (cmd_debt@42, clip_tasks@33, generate_repo_map@38, scan_ponytail_debt@38) <-
#   general gate held at 42 to stay green -> systemic decompose pass (task: 'mimori global CC<=10 pass') once over-10 count < 20
def _test_complexity_budget() -> None:
    """CC gate: refactored hotspots stay flat; no function regresses past 42."""
    import ast as _ast

    def cc(node) -> int:
        n = 1
        for ch in _ast.walk(node):
            if isinstance(ch, (ast.If, ast.While, ast.For, ast.ExceptHandler, ast.IfExp, ast.Assert)):
                n += 1
            elif isinstance(ch, ast.BoolOp):
                n += len(ch.values) - 1
            elif isinstance(ch, ast.comprehension):
                n += 1 + len(ch.ifs)
        return n

    tree = _ast.parse(Path(__file__).read_text(encoding="utf-8"))
    offenders = []
    hotspots = {"cmd_todo": 10, "build_import_graph": 10}
    for node in _ast.walk(tree):
        if isinstance(node, ast.FunctionDef):
            score = cc(node)
            limit = hotspots.get(node.name, 42)
            if score > limit:
                offenders.append(f"{node.name}:{node.lineno} CC={score}>{limit}")
    assert not offenders, f"Complexity budget exceeded: {offenders}"


