class FileInfo:
    """One repo file: its symbols, its imports, and the signals used to rank it."""

    def __init__(self, path: str, size: int):
        self.path = path
        self.size = size
        self.lines = 0
        self.doc: Optional[str] = None
        self.symbols: List[Tuple[int, int, str]] = []  # (lineno, depth, text)
        self.imports: List[tuple] = []
        self.importers: Set[str] = set()
        self.depends_on: Set[str] = set()
        self.churn = 0
        self.entry = False
        self.executable = False
        self.pagerank: float = 0.0

    @property
    def in_degree(self) -> int:
        return len(self.importers)

    @property
    def score(self) -> int:
        return (4 * self.in_degree) + min(self.churn, 10) + (6 if self.entry else 0) + (1 if self.symbols else 0)


def _elide(text: str, limit: int) -> str:
    """Truncate visibly, so a cut signature never reads as a complete one."""
    return text if len(text) <= limit else text[:limit - 1] + "…"


def _fmt_signature(node, drop_self: bool) -> str:
    try:
        params = ast.unparse(node.args)
    except Exception:
        params = "..."
    if drop_self:
        for prefix in ("self, ", "cls, "):
            if params.startswith(prefix):
                params = params[len(prefix):]
                break
        if params in ("self", "cls"):
            params = ""
    sig = f"{node.name}({params})"
    if node.returns is not None:
        with contextlib.suppress(Exception):
            sig += f" -> {ast.unparse(node.returns)}"
    prefix = "async " if isinstance(node, ast.AsyncFunctionDef) else ""
    return _elide(prefix + sig, 88)


def _first_doc_line(node) -> Optional[str]:
    try:
        doc = ast.get_docstring(node)
    except Exception:
        return None
    if not doc:
        return None
    return doc.strip().splitlines()[0].strip()[:100]


def parse_python(content: str) -> Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]:
    """Symbols with signatures + line numbers, plus import specs for the graph."""
    symbols: List[Tuple[int, int, str]] = []
    imports: List[tuple] = []
    try:
        tree = ast.parse(content)
    except Exception:
        # Unparseable (syntax error, different python dialect): degrade to names only.
        for i, line in enumerate(content.splitlines(), 1):
            m = re.match(r"^(?:class|def|async def)\s+([A-Za-z0-9_]+)", line.strip())
            if m:
                symbols.append((i, 0, m.group(0)))
        return None, symbols, imports

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            imports.extend(("py_abs", a.name) for a in node.names)
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                if node.module:
                    imports.append(("py_rel", node.level, node.module))
                else:
                    imports.extend(("py_rel", node.level, a.name) for a in node.names)
            elif node.module:
                imports.append(("py_abs", node.module))

    for node in tree.body:
        if isinstance(node, ast.ClassDef):
            symbols.append((node.lineno, 0, f"class {node.name}"))
            for sub in node.body:
                if isinstance(sub, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    if sub.name.startswith("_") and sub.name != "__init__":
                        continue
                    symbols.append((sub.lineno, 1, _fmt_signature(sub, drop_self=True)))
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            symbols.append((node.lineno, 0, _fmt_signature(node, drop_self=False)))

    return _first_doc_line(tree), symbols, imports


GENERIC_PATTERNS = {
    ".js": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class)\s+([A-Za-z0-9_$]+)",
            r"^export\s+(?:const|let|var)\s+([A-Za-z0-9_$]+)"],
    ".jsx": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class)\s+([A-Za-z0-9_$]+)",
             r"^export\s+(?:const|let|var)\s+([A-Za-z0-9_$]+)"],
    ".ts": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class|interface|type|enum)\s+([A-Za-z0-9_$]+)",
            r"^export\s+(?:const|let|var)\s+([A-Za-z0-9_$]+)"],
    ".tsx": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class|interface|type|enum)\s+([A-Za-z0-9_$]+)",
             r"^export\s+(?:const|let|var)\s+([A-Za-z0-9_$]+)"],
    ".go": [r"^func\s+(?:\([^\)]+\)\s+)?([A-Za-z0-9_]+)", r"^type\s+([A-Za-z0-9_]+)\s+(?:struct|interface)"],
    ".rs": [r"^(?:pub\s+)?(?:fn|struct|enum|trait|type)\s+([A-Za-z0-9_]+)"],
    ".c": [r"^[A-Za-z0-9_ *]+\s+([A-Za-z0-9_]+)\s*\([^)]*\)\s*\{"],
    ".cpp": [r"^(?:class|struct)\s+([A-Za-z0-9_]+)", r"^[A-Za-z0-9_ *:]+\s+([A-Za-z0-9_]+)\s*\([^)]*\)\s*\{"],
    ".h": [r"^(?:class|struct)\s+([A-Za-z0-9_]+)", r"^[A-Za-z0-9_ *:]+\s+([A-Za-z0-9_]+)\s*\([^)]*\);"],
    ".rb": [
        r"^\s*class\s+([A-Za-z0-9_:]+)",
        r"^\s*module\s+([A-Za-z0-9_:]+)",
        r"^\s*def\s+([A-Za-z0-9_?!]+)",
    ],
}

JS_IMPORT_RE = re.compile(r"""(?:from|require\(|import\()\s*['"]([^'"]+)['"]""")
JS_EXPORT_RE = re.compile(r"""export\s+.*\s+from\s*['"]([^'"]+)['"]""")
GO_IMPORT_BLOCK_RE = re.compile(r"""import\s*\(([^)]+)\)""", re.S)
GO_SINGLE_IMPORT_RE = re.compile(r"""import\s+(?:[a-zA-Z0-9_.]+\s+)?["']([^"']+)["']""")
RUST_MOD_RE = re.compile(r"""^\s*(?:pub\s+)?mod\s+([a-zA-Z0-9_]+)\s*;""")
RUST_USE_RE = re.compile(r"""^\s*(?:pub\s+)?use\s+([a-zA-Z0-9_:]+)""")
RUBY_REQUIRE_RE = re.compile(r"""^\s*(?:require|require_relative)\s+['"]([^'"]+)['"]""")


def parse_generic(content: str, ext: str) -> Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]:
    symbols: List[Tuple[int, int, str]] = []
    imports: List[tuple] = []
    regexes = [re.compile(p) for p in GENERIC_PATTERNS.get(ext, [])]

    if ext == ".go":
        for block in GO_IMPORT_BLOCK_RE.findall(content):
            imports.extend(("go_spec", s) for s in re.findall(r'["\']([^"\']+)["\']', block))
        imports.extend(("go_spec", s) for s in GO_SINGLE_IMPORT_RE.findall(content))

    for i, raw in enumerate(content.splitlines(), 1):
        line = raw.strip()
        if ext in JS_EXTS:
            imports.extend(("js_spec", spec) for spec in JS_IMPORT_RE.findall(line))
            imports.extend(("js_spec", spec) for spec in JS_EXPORT_RE.findall(line))
        elif ext == ".rs":
            m_mod = RUST_MOD_RE.match(line)
            if m_mod:
                imports.append(("rs_mod", m_mod.group(1)))
            m_use = RUST_USE_RE.match(line)
            if m_use:
                imports.append(("rs_use", m_use.group(1)))
        elif ext == ".rb":
            m_req = RUBY_REQUIRE_RE.match(line)
            if m_req:
                imports.append(("rb_req", m_req.group(1)))

        for c in regexes:
            if c.match(line):
                symbols.append((i, 0, _elide(line.rstrip("{ ").strip(), 88)))
                break
    return None, symbols, imports


SHEBANG_EXTS = {"python": ".py", "node": ".js", "deno": ".ts", "bun": ".ts", "ruby": ".rb"}


def _sniff_shebang(full: Path) -> Optional[str]:
    """Map an extensionless script to a parser via its shebang."""
    try:
        with open(full, "rb") as f:
            first = f.readline(200).decode("utf-8", errors="ignore")
    except OSError:
        return None
    if not first.startswith("#!"):
        return None
    for name, ext in SHEBANG_EXTS.items():
        if name in first:
            return ext
    return None


_TS_LANGUAGE_MAP = {
    ".js": "javascript",
    ".jsx": "javascript",
    ".ts": "typescript",
    ".tsx": "tsx",
    ".go": "go",
    ".rs": "rust",
    ".rb": "ruby",
    ".c": "c",
    ".cpp": "cpp",
    ".h": "c",
}

_TS_PARSERS: Dict[str, Any] = {}


def _get_tree_sitter_parser(ext: str) -> Optional[Any]:
    if tree_sitter is None:
        return None
    lang_name = _TS_LANGUAGE_MAP.get(ext)
    if not lang_name:
        return None
    if lang_name in _TS_PARSERS:
        return _TS_PARSERS[lang_name]

    try:
        mod_name = f"tree_sitter_{lang_name}"
        lang_mod = __import__(mod_name)
        lang_func = getattr(lang_mod, f"language_{lang_name}", getattr(lang_mod, "language", None))
        if callable(lang_func):
            lang = tree_sitter.Language(lang_func())
            parser = tree_sitter.Parser(lang)
            _TS_PARSERS[lang_name] = parser
            return parser
    except Exception:
        pass
    _TS_PARSERS[lang_name] = None
    return None


def parse_tree_sitter(content: str, ext: str) -> Optional[Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]]:
    parser = _get_tree_sitter_parser(ext)
    if parser is None:
        return None
    try:
        tree = parser.parse(bytes(content, "utf-8"))
        symbols: List[Tuple[int, int, str]] = []
        imports: List[tuple] = []

        cursor = tree.walk()
        visited_children = False
        while True:
            if not visited_children:
                node = cursor.node
                if node.type in ("class_declaration", "class_definition", "struct_item", "interface_declaration", "type_declaration"):
                    name_node = node.child_by_field_name("name")
                    if name_node:
                        symbols.append((node.start_point.row + 1, 0, f"class {name_node.text.decode('utf-8', errors='ignore')}"))
                elif node.type in ("function_declaration", "function_definition", "method_definition", "function_item", "method_declaration"):
                    name_node = node.child_by_field_name("name")
                    if name_node:
                        symbols.append((node.start_point.row + 1, 0, f"func {name_node.text.decode('utf-8', errors='ignore')}"))
                elif node.type in ("import_statement", "import_declaration", "use_declaration"):
                    source_node = node.child_by_field_name("source") or node.child_by_field_name("argument")
                    if source_node:
                        spec = source_node.text.decode("utf-8", errors="ignore").strip("\"'")
                        if ext in JS_EXTS:
                            imports.append(("js_spec", spec))
                        elif ext == ".go":
                            imports.append(("go_spec", spec))

                if cursor.goto_first_child():
                    continue
            if cursor.goto_next_sibling():
                visited_children = False
                continue
            if not cursor.goto_parent():
                break
            visited_children = True

        if symbols or imports:
            return None, symbols, imports
    except Exception:
        pass
    return None


def parse_ast_grep(full_path: Path, ext: str) -> Optional[Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]]:
    if not AST_GREP_BIN or not full_path.is_file():
        return None
    try:
        cmd = [AST_GREP_BIN, "run", "--pattern", "$$$", "--json", str(full_path)]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=2, check=False)
        if res.returncode == 0 and res.stdout.strip():
            matches = json.loads(res.stdout)
            if isinstance(matches, list) and matches:
                symbols: List[Tuple[int, int, str]] = []
                imports: List[tuple] = []
                for m in matches:
                    text = m.get("text", "").strip()
                    first_line = text.splitlines()[0].strip() if text else ""
                    line_no = m.get("range", {}).get("start", {}).get("line", 0) + 1
                    
                    if first_line.startswith("//") or first_line.startswith("/*") or first_line.startswith("#"):
                        continue

                    if any(first_line.startswith(k) for k in ("export class", "class ", "export interface", "interface ", "export type", "type ", "pub struct", "struct ", "pub trait", "trait ", "pub fn", "fn ", "func ", "def ", "module ")):
                        clean_sig = _elide(first_line.rstrip("{ ").strip(), 88)
                        symbols.append((line_no, 0, clean_sig))

                    if "from " in text or "import " in text or "require(" in text:
                        for spec in JS_IMPORT_RE.findall(text):
                            imports.append(("js_spec", spec))

                if symbols or imports:
                    return None, symbols, imports
    except Exception as e:
        _debug(f"ast-grep probe failed on {full_path}: {e!r}")
    return None


def parse_polyglot(content: str, ext: str, full_path: Optional[Path] = None) -> Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]:
    """Opportunistic polyglot AST parser. Uses tree-sitter/ast-grep if installed, else pure stdlib regex."""
    if os.environ.get("MIMORI_FORCE_REGEX"):
        return parse_generic(content, ext)
    res = parse_tree_sitter(content, ext)
    if res is not None:
        return res
    if full_path:
        res = parse_ast_grep(full_path, ext)
        if res is not None:
            return res
    return parse_generic(content, ext)


def analyze_file(root: Path, rel: str) -> Optional[FileInfo]:
    full = root / rel
    try:
        st = full.stat()
    except OSError:
        return None
    info = FileInfo(rel, st.st_size)
    info.executable = bool(st.st_mode & 0o111)

    ext = Path(rel).suffix.lower()
    if ext not in CODE_EXTS and info.executable:
        ext = _sniff_shebang(full) or ext  # extensionless scripts in bin/ are common
    if ext not in CODE_EXTS or st.st_size > MAX_PARSE_BYTES:
        return info

    try:
        content = full.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return info

    info.lines = content.count("\n") + 1
    if ext == ".py":
        info.doc, info.symbols, info.imports = parse_python(content)
    else:
        info.doc, info.symbols, info.imports = parse_polyglot(content, ext, full)
    return info


