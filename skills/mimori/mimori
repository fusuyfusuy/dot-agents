# --------------------------------------------------------------------------
# concurrency & atomic file operations
# --------------------------------------------------------------------------

@contextlib.contextmanager
def file_lock(lock_path: Path, timeout: float = 10.0):
    """Advisory file lock using fcntl.flock on POSIX; graceful no-op if fcntl unavailable."""
    if fcntl is None:
        yield
        return
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    f = None
    try:
        f = open(lock_path, "a")
        start = time.time()
        while True:
            try:
                fcntl.flock(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except (BlockingIOError, OSError):
                if time.time() - start > timeout:
                    break
                time.sleep(0.05)
        yield
    finally:
        if f is not None:
            try:
                fcntl.flock(f.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                f.close()
            except OSError:
                pass


def atomic_write_text(path: Path, content: str, encoding: str = "utf-8", lock: bool = True) -> None:
    """Atomically write text to path using a temporary file and os.replace, with optional advisory locking."""
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_file = path.with_name(f"{path.name}.lock")
    cm = file_lock(lock_file) if lock else contextlib.nullcontext()
    with cm:
        tmp_file = path.with_name(f".{path.name}.tmp.{os.getpid()}.{uuid.uuid4().hex[:6]}")
        try:
            tmp_file.write_text(content, encoding=encoding)
            os.replace(tmp_file, path)
        finally:
            if tmp_file.exists():
                try:
                    tmp_file.unlink()
                except OSError:
                    pass


