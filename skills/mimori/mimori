RE_INLINE_REF = re.compile(r"`([^`\n]+)`|\[([^\]]+)\]\(([^)]+)\)")


def scan_stale_references(root: Path, all_paths: Set[str]) -> List[str]:
    """Scan memory.md and tasks.md for dead file references and dormant (>60d) rules."""
    mimori_dir = get_mimori_dir(root)
    notices: List[str] = []
    dead_refs: Set[str] = set()

    all_paths_lower = {p.lower() for p in all_paths}
    all_stems_lower = {Path(p).name.lower() for p in all_paths}

    target_files = [
        ("memory.md", mimori_dir / "memory.md"),
        ("tasks.md", get_tasks_file(root)),
    ]

    for fname, fpath in target_files:
        if not fpath.is_file():
            continue
        content = fpath.read_text(encoding="utf-8", errors="ignore")
        for m in RE_INLINE_REF.finditer(content):
            ref = (m.group(1) or m.group(3) or "").strip()
            if not ref:
                continue
            if any(ch in ref for ch in ("*", "?", "!", "<", ">", "…", "...", "@", "$", "~", "{", "}", "%", "^")):
                continue
            if ref.startswith(("http://", "https://", "file://", "--", "-")):
                continue
            if " " in ref or "(" in ref or ")" in ref:
                continue
            has_ext = any(ref.endswith(ext) for ext in CODE_EXTS | {".md", ".json", ".jsonl", ".sh", ".toml", ".yml", ".yaml"})
            if "/" in ref or has_ext:
                clean_ref = ref.removeprefix("./").rstrip("/").split("#")[0].split(":")[0]
                if not clean_ref:
                    continue
                if ref.startswith("/") and not has_ext:
                    continue
                if ref.startswith("/") and Path(ref).exists():
                    continue
                if (root / clean_ref).is_dir() or (root / clean_ref).is_file():
                    continue
                if clean_ref.lower() not in all_paths_lower and clean_ref.lower() not in all_stems_lower:
                    dead_refs.add(f"{fname}: '{clean_ref}' not found in repo")

    for dr in sorted(dead_refs)[:4]:
        notices.append(dr)
    if len(dead_refs) > 4:
        notices.append(f"... and {len(dead_refs) - 4} more dead references")

    return notices


def cmd_dump(args: argparse.Namespace) -> int:
    root = find_repo_root()
    ensure_git_repo(root)
    mimori_dir = get_mimori_dir(root)
    total = resolve_budget(getattr(args, "budget", None), DUMP_TOTAL_BUDGET)
    # Prose stores each get a third; the map takes what is left. Scaling with the
    # total is what makes a larger preset help every section, not just the map.
    prose_budget = total // 3

    out = [f"# Agent Context Snapshot ({root.name})\n"]

    state = get_working_state(root)
    if state:
        out.append("## Working state\n")
        out.append(state)
        out.append("\n---\n")

    stale_notices = scan_stale_references(root, set(list_files(root)))
    if stale_notices:
        decay_block = ["> [!NOTE]", "> **Decay Notice**: Stale/dead references detected in workspace memory:"]
        for sn in stale_notices:
            decay_block.append(f"> - {sn}")
        out.append("\n".join(decay_block) + "\n\n---\n")

    mem_file = mimori_dir / "memory.md"
    if mem_file.is_file():
        out.append("## Project Memory\n")
        out.append(clip_memory(mem_file.read_text(encoding="utf-8", errors="ignore").strip(), prose_budget))
        out.append("\n---\n")

    dec_file = mimori_dir / "decisions.md"
    if dec_file.is_file():
        out.append("## Architecture Decisions\n")
        out.append(clip_decisions(dec_file.read_text(encoding="utf-8", errors="ignore").strip(), prose_budget))
        out.append("\n---\n")

    tasks_file = get_tasks_file(root)
    if tasks_file.is_file():
        tasks_text = tasks_file.read_text(encoding="utf-8", errors="ignore").strip()
        if tasks_text:
            clipped_tasks = clip_tasks(tasks_text, prose_budget)
            if clipped_tasks.strip():
                out.append("## Tasks & Backlog\n")
                out.append(clipped_tasks)
                out.append("\n---\n")

    # Build the activity tail before the map so the map's share is what is genuinely
    # left over — otherwise DUMP_TOTAL_BUDGET would not be a total at all.
    tail: List[str] = []
    act_file = mimori_dir / "activity.jsonl"
    if act_file.is_file():
        lines = act_file.read_text(encoding="utf-8", errors="ignore").strip().splitlines()
        if lines:
            tail.append("## Recent Activity\n")
            entries: List[str] = []
            elided = False
            for l in lines[-5:]:
                try:
                    r = json.loads(l)
                except Exception:
                    continue
                ts = r.get("timestamp", "")[:10]
                summary = r.get("summary", "")
                if len(summary) > ACTIVITY_SUMMARY_LIMIT:
                    summary = _elide(summary, ACTIVITY_SUMMARY_LIMIT)
                    elided = True
                files = r.get("files", [])
                if len(files) > ACTIVITY_FILES_SHOWN:
                    files_str = ", ".join(files[:ACTIVITY_FILES_SHOWN]) + f", +{len(files) - ACTIVITY_FILES_SHOWN} more"
                    elided = True
                else:
                    files_str = ", ".join(files) or "none"
                entries.append(f"- **{ts} [{r.get('action')}]**: {summary} (files: {files_str})")

            # Keep the most recent entries first when the budget can't fit all of them.
            kept: List[str] = []
            used = 0
            for entry in reversed(entries):
                if used + len(entry) + 1 > DUMP_ACTIVITY_BUDGET:
                    break
                kept.append(entry)
                used += len(entry) + 1
            dropped = len(entries) - len(kept)
            kept.reverse()
            tail.extend(kept)
            if dropped or elided:
                tail.append(f"_{len(kept)} of {len(entries)} entries shown"
                             f"{', some elided' if elided else ''} — read `.mimori/activity.jsonl`._")

    spent = sum(len(chunk) for chunk in out) + sum(len(chunk) for chunk in tail)
    out.append("## Structure & Symbol Map (live)\n")
    out.append(generate_repo_map(root, budget=max(DUMP_MAP_MIN_BUDGET, total - spent),
                                 focus=resolve_focus(getattr(args, "focus", None))).strip())
    out.append("\n---\n")
    out.extend(tail)

    rendered = "\n".join(out)

    out_target = getattr(args, "file", None)
    if out_target is not None:
        if out_target == "" or out_target is True or out_target is None or isinstance(out_target, bool):
            commit_id = get_repo_identifier(root)
            temp_dir = get_user_temp_dir()
            prune_user_temp_dir(temp_dir, current_repo=root.name)
            dest_file = temp_dir / f"ctx-{root.name}-{commit_id}.md"
        else:
            dest_file = Path(out_target).resolve()
            dest_file.parent.mkdir(parents=True, exist_ok=True)

        atomic_write_text(dest_file, rendered, encoding="utf-8", lock=False)
        print(f"Wrote context snapshot to {dest_file}")
        return 0

    print(rendered)
    return 0


def cmd_clean(args: argparse.Namespace) -> int:
    temp_dir = get_user_temp_dir()
    if not temp_dir.is_dir():
        print(f"Mimori cache directory {temp_dir} does not exist.")
        return 0

    if getattr(args, "all", False):
        deleted = 0
        freed = 0
        for p in temp_dir.glob("ctx-*.md"):
            try:
                sz = p.stat().st_size
                p.unlink(missing_ok=True)
                deleted += 1
                freed += sz
            except OSError:
                pass
        print(f"Cleared all cached snapshots: {deleted} files removed ({format_bytes(freed)} freed) from {temp_dir}")
        return 0

    pruned_count, pruned_bytes = prune_user_temp_dir(temp_dir)
    print(f"Pruned stale snapshots: {pruned_count} files removed ({format_bytes(pruned_bytes)} freed) from {temp_dir}")
    return 0


def _normalize_todo_action(action: str, target: str) -> Tuple[str, str]:
    """Valid action names pass through; anything else is treated as a list search query."""
    valid_actions = {"list", "ls", "add", "start", "done", "reopen", "rm", "remove"}
    if action not in valid_actions:
        target = f"{action} {target}".strip() if target else action
        action = "list"
    return action, target


def _filter_task_sections(
    sections: List[Tuple[str, List[Any]]],
    status_filter: str,
    tag_filters: List[str],
    search_query: str,
) -> List[Tuple[str, List[TaskItem]]]:
    """Returns (heading, [TaskItem]) pairs whose items match status/tag/search filters."""
    out: List[Tuple[str, List[TaskItem]]] = []
    for heading, items in sections:
        matching = [
            it for it in items
            if isinstance(it, TaskItem)
            and (status_filter == "all" or it.status == status_filter)
            and (not tag_filters or any(tf in [t.lower() for t in it.tags] for tf in tag_filters))
            and (not search_query
                 or search_query in it.text.lower()
                 or any(search_query in t.lower() for t in it.tags))
        ]
        if matching:
            out.append((heading, matching))
    return out


def _section_heading_color(heading: str) -> str:
    head_low = heading.lower()
    if "in progress" in head_low or "in-progress" in head_low:
        return "1;36"
    if "idea" in head_low or "backlog" in head_low:
        return "1;35"
    if "complete" in head_low or "done" in head_low:
        return "1;32"
    return "1;33"


_STATUS_BOX = {
    "in_progress": ("[/]", "1;36"),
    "idea": ("[?]", "1;35"),
    "done": ("[x]", "1;32"),
    "todo": ("[ ]", "1;33"),
}


def _format_task_line(it: TaskItem, plain: bool) -> str:
    idx_str = colorize(f"#{it.index}", "2", plain=plain)
    box, box_color = _STATUS_BOX.get(it.status, ("[ ]", "1;33"))
    box_str = colorize(box, box_color, plain=plain)
    prio_str = ""
    if it.prio:
        p_code = "1;31" if it.prio in ("high", "urgent", "p0", "p1") else "1;33" if it.prio in ("med", "p2") else "1;34"
        prio_str = colorize(f"({it.prio}) ", p_code, plain=plain)
    tags_str = "".join(colorize(f"[{t}]", "36", plain=plain) + " " for t in it.tags)
    date_str = ""
    if it.completed_date and it.status == "done":
        date_str = colorize(f" ({it.completed_date})", "2", plain=plain)
    return f"  {idx_str} {box_str} {prio_str}{tags_str}{it.text}{date_str}"


def _render_task_list(
    filtered_sections: List[Tuple[str, List[TaskItem]]],
    tasks_file: Path,
    root: Path,
    plain: bool,
    status_filter: str,
    search_query: str,
) -> None:
    print(colorize(f"# Tasks & Backlog ({tasks_file.relative_to(root)})", "1;37", plain=plain))
    print()
    for heading, items in filtered_sections:
        hdr_color = _section_heading_color(heading)
        head_low = heading.lower()
        is_completed_section = "complete" in head_low or "done" in head_low
        hidden_count = 0
        display_items = items
        if is_completed_section and len(items) > 5 and status_filter == "all" and not search_query:
            hidden_count = len(items) - 5
            display_items = items[-5:]

        hdr_text = heading.lstrip("#").strip()
        if hidden_count > 0:
            hdr_text += f" ({len(display_items)} shown, {hidden_count} hidden)"
        print(colorize(f"[{hdr_text}]", hdr_color, plain=plain))

        for it in display_items:
            print(_format_task_line(it, plain))
        print()


def _todo_list(args: argparse.Namespace, sections: List[Tuple[str, List[Any]]],
               tasks_file: Path, root: Path, target: str) -> int:
    status_filter = getattr(args, "status", "all")
    tag_filters = [t.lower() for t in getattr(args, "tag", []) if t]
    plain = getattr(args, "plain", False)
    search_query = target.lower() if target else ""

    filtered = _filter_task_sections(sections, status_filter, tag_filters, search_query)
    if not filtered:
        if search_query or status_filter != "all" or tag_filters:
            print("No tasks matching filters.")
        else:
            print("No active tasks.")
        return 0

    _render_task_list(filtered, tasks_file, root, plain, status_filter, search_query)
    return 0


def _todo_add(args: argparse.Namespace, target: str, preamble: str,
              sections: List[Tuple[str, List[Any]]], tasks_file: Path) -> int:
    if not target:
        print("Error: task description required. Usage: mimori todo add <description> [--prio high|med|low] [--tag tag] [--start] [--idea]")
        return 1

    is_idea = getattr(args, "idea", False)
    is_start = getattr(args, "start", False)
    prio = getattr(args, "prio", None)
    tags = getattr(args, "tag", []) or []

    if is_idea:
        target_type, status = "ideas", "idea"
    elif is_start:
        target_type, status = "in_progress", "in_progress"
    else:
        target_type, status = "active", "todo"

    s_idx = ensure_task_section(sections, target_type)
    new_item = TaskItem(
        raw_line="",
        section_idx=s_idx,
        section_name=sections[s_idx][0],
        status=status,
        text=target,
        prio=prio,
        tags=tags,
    )
    sections[s_idx][1].append(new_item)
    atomic_write_text(tasks_file, serialize_tasks_document(preamble, sections), encoding="utf-8")
    get_all_tasks(sections)  # recompute global indexes after append
    print(f"Added task #{new_item.index} to {sections[s_idx][0].lstrip('#').strip()}: {new_item.text}")
    return 0


def _move_task(sections: List[Tuple[str, List[Any]]], task: TaskItem,
               dest_type: str, status: str, completed_date: Optional[str]) -> None:
    """Relocates a task across sections, updating status/date/section fields in place."""
    sections[task.section_idx][1].remove(task)
    dest_idx = ensure_task_section(sections, dest_type)
    task.status = status
    task.completed_date = completed_date
    task.section_idx = dest_idx
    task.section_name = sections[dest_idx][0]
    sections[dest_idx][1].append(task)


def _transition_task(sections: List[Tuple[str, List[Any]]], all_tasks: List[TaskItem],
                     target: str, dest_type: str, status: str, completed_date: Optional[str],
                     past: str, dest_display: str, tasks_file: Path, preamble: str) -> int:
    """Shared body of start/done/reopen: resolve task, move it, persist, report."""
    task, err = find_matching_task(all_tasks, target)
    if err:
        print(f"Error: {err}")
        return 1
    _move_task(sections, task, dest_type, status, completed_date)
    atomic_write_text(tasks_file, serialize_tasks_document(preamble, sections), encoding="utf-8")
    print(f"{past} task #{task.index}: {task.text} (moved to {dest_display})")
    return 0


def _todo_remove(sections: List[Tuple[str, List[Any]]], all_tasks: List[TaskItem],
                 target: str, tasks_file: Path, preamble: str) -> int:
    task, err = find_matching_task(all_tasks, target)
    if err:
        print(f"Error: {err}")
        return 1
    sections[task.section_idx][1].remove(task)
    atomic_write_text(tasks_file, serialize_tasks_document(preamble, sections), encoding="utf-8")
    print(f"Removed task #{task.index}: {task.text}")
    return 0


def cmd_todo(args: argparse.Namespace) -> int:
    root = find_repo_root()
    mimori_dir = get_mimori_dir(root)
    mimori_dir.mkdir(exist_ok=True)
    tasks_file = get_tasks_file(root)

    action = getattr(args, "action", "list") or "list"
    target_raw = getattr(args, "target", [])
    target = " ".join(target_raw).strip() if isinstance(target_raw, list) else str(target_raw).strip()
    action, target = _normalize_todo_action(action, target)

    if not tasks_file.exists():
        if action == "add":
            ensure_git_repo(root)
            atomic_write_text(tasks_file, DEFAULT_TASKS_TEMPLATE, encoding="utf-8")
        else:
            print(f"No tasks tracked yet in {mimori_dir.relative_to(root)}/tasks.md.")
            print("Run 'mimori init' or 'mimori todo add <description>' to start tracking tasks.")
            return 0

    content = tasks_file.read_text(encoding="utf-8", errors="ignore")
    preamble, sections = parse_tasks_document(content)
    all_tasks = get_all_tasks(sections)

    dispatcher = {
        "list": lambda: _todo_list(args, sections, tasks_file, root, target),
        "ls": lambda: _todo_list(args, sections, tasks_file, root, target),
        "add": lambda: _todo_add(args, target, preamble, sections, tasks_file),
        "start": lambda: _transition_task(sections, all_tasks, target, "in_progress", "in_progress", None,
                                          "Started", "In Progress", tasks_file, preamble),
        "done": lambda: _transition_task(sections, all_tasks, target, "completed", "done",
                                         datetime.date.today().isoformat(), "Completed", "Completed",
                                         tasks_file, preamble),
        "reopen": lambda: _transition_task(sections, all_tasks, target, "active", "todo", None,
                                           "Reopened", "Active Tasks", tasks_file, preamble),
        "rm": lambda: _todo_remove(sections, all_tasks, target, tasks_file, preamble),
        "remove": lambda: _todo_remove(sections, all_tasks, target, tasks_file, preamble),
    }
    handler = dispatcher.get(action)
    return handler() if handler else 0


def cmd_idea(args: argparse.Namespace) -> int:
    action = getattr(args, "action", "list") or "list"
    target_raw = getattr(args, "target", [])
    target = " ".join(target_raw).strip() if isinstance(target_raw, list) else str(target_raw).strip()

    if action in ("add",):
        setattr(args, "idea", True)
        return cmd_todo(args)
    elif action in ("list", "ls"):
        setattr(args, "status", "idea")
        return cmd_todo(args)
    elif action == "promote":
        root = find_repo_root()
        tasks_file = get_tasks_file(root)
        if not tasks_file.exists():
            print("No tasks or ideas tracked yet.")
            return 1
        content = tasks_file.read_text(encoding="utf-8", errors="ignore")
        preamble, sections = parse_tasks_document(content)
        all_tasks = get_all_tasks(sections)
        task, err = find_matching_task(all_tasks, target)
        if err:
            print(f"Error: {err}")
            return 1
        sections[task.section_idx][1].remove(task)
        dest_idx = ensure_task_section(sections, "active")
        task.status = "todo"
        task.completed_date = None
        task.section_idx = dest_idx
        task.section_name = sections[dest_idx][0]
        sections[dest_idx][1].append(task)
        atomic_write_text(tasks_file, serialize_tasks_document(preamble, sections), encoding="utf-8")
        print(f"Promoted idea #{task.index} to Active Tasks: {task.text}")
        return 0
    elif action in ("rm", "remove"):
        return cmd_todo(args)
    else:
        setattr(args, "status", "idea")
        return cmd_todo(args)


