        f_a_mid = temp_dir / "ctx-repoA-c2.md"
        f_a_mid.write_text("mid snapshot", encoding="utf-8")
        os.utime(f_a_mid, (now - 2 * 3600, now - 2 * 3600))

        f_a_new = temp_dir / "ctx-repoA-c3.md"
        f_a_new.write_text("new snapshot", encoding="utf-8")
        os.utime(f_a_new, (now - 1 * 3600, now - 1 * 3600))

        # Repo B: 3 recent snapshots (30m, 20m, 10m ago) -> with max_per_repo=2, oldest should be pruned
        f_b_1 = temp_dir / "ctx-repoB-c1.md"
