def _split_sections(text: str) -> Tuple[str, List[Tuple[str, str]]]:
    """Split markdown into (preamble, [(heading, body)]) at its dominant heading level.

    The level is detected rather than assumed: real files disagree with the template
    (titirek writes `## ADR-001: ...`, this repo writes `### [date] Title`).
    """
    lines = text.splitlines()
    # A heading inside an HTML comment is documentation, not a record: the shipped
    # templates show the record format that way, and it must not parse as an entry.
    visible, in_comment = [], False
    for line in lines:
        visible.append(not in_comment)
        if "<!--" in line and "-->" not in line:
            in_comment = True
        elif in_comment and "-->" in line:
            in_comment = False

    counts = {lv: sum(1 for i, l in enumerate(lines)
                      if visible[i] and re.match(rf"^#{{{lv}}}\s+\S", l)) for lv in (2, 3, 4)}
    level = max(counts, key=lambda lv: (counts[lv], -lv))
    if counts[level] == 0:
        return text, []

    pat = re.compile(rf"^#{{{level}}}\s+\S")
    preamble: List[str] = []
    sections: List[List] = []
    for i, line in enumerate(lines):
        if visible[i] and pat.match(line):
            sections.append([line, []])
        elif sections:
            sections[-1][1].append(line)
        else:
            preamble.append(line)
    return "\n".join(preamble).strip(), [(h, "\n".join(b).rstrip()) for h, b in sections]


def _is_superseded(section: Tuple[str, str]) -> bool:
    """An ADR that names its replacement is history, not current guidance."""
    heading, body = section
    return "superseded by" in body.lower() or "[superseded]" in heading.lower()


def clip_decisions(text: str, limit: int) -> str:
    """Keep every ADR *title*, expand bodies newest-first until the budget runs out.

    Positional clipping is wrong for ADRs: they are not news, and the oldest entries
    are usually the load-bearing invariants. Titles cost ~60 chars each, so the full
    list of decisions stays visible indefinitely and any body can still be read from
    the file.
    """
    preamble, sections = _split_sections(text)
    if not sections:
        return text

    live = [i for i in range(len(sections)) if not _is_superseded(sections[i])]
    if len(live) == len(sections) and len(text) <= limit:
        return text

    used = len(preamble) + sum(len(h) + 2 for h, _ in sections) + 160
    expanded = set()
    for idx in reversed(live):  # newest live entries are appended last
        body = sections[idx][1]
        if used + len(body) + 2 > limit:
            continue
        used += len(body) + 2
        expanded.add(idx)

    out = [preamble] if preamble else []
    for idx, (heading, body) in enumerate(sections):
        if idx in expanded:
            out.append(f"{heading}\n{body}".rstrip())
        elif idx not in live:
            out.append(f"{heading}\n- _(superseded — kept for history, read `.mimori/decisions.md`)_")
        else:
            out.append(f"{heading}\n- _(body trimmed to budget — read `.mimori/decisions.md`)_")
    hidden = len(sections) - len(expanded)
    if hidden:
        superseded = len(sections) - len(live)
        note = f"_{hidden} of {len(sections)} decisions shown by title only"
        if superseded:
            note += f" ({superseded} superseded)"
        out.append(note + "; no decision is hidden entirely._")
    return "\n\n".join(out)


MEMORY_PRIORITY = (
    ("invariant", "rule", "architecture", "constraint"),
    ("gotcha", "vocab", "domain", "glossar", "edge"),
)


def _memory_priority(heading: str) -> int:
    low = heading.lower()
    for rank, keywords in enumerate(MEMORY_PRIORITY):
        if any(k in low for k in keywords):
            return rank
    return len(MEMORY_PRIORITY)  # epics/status: the most perishable, trimmed first


def clip_memory(text: str, limit: int) -> str:
    """Trim by section priority, not file position.

    Invariants and gotchas outlive "active epics", but epics sit first in the
    template — clipping from the top keeps the changelog and drops the durable rules.
    """
    preamble, sections = _split_sections(text)
    if not sections or len(text) <= limit:
        return text

    order = sorted(range(len(sections)), key=lambda i: (_memory_priority(sections[i][0]), i))
    used = len(preamble) + sum(len(sections[i][0]) + 2 for i in range(len(sections))) + 160
    kept: Dict[int, str] = {}
    for i in order:
        body = sections[i][1]
        room = limit - used
        if len(body) + 2 <= room:
            kept[i] = body
            used += len(body) + 2
        elif room > 300:
            # Partially include rather than skip: a greedy fill would drop the single
            # most valuable section whenever it is the largest, and backfill with
            # lower-priority ones. Priority has to dominate size.
            cut = body[:room - 90]
            kept[i] = cut[:cut.rfind("\n") if "\n" in cut else len(cut)].rstrip() + \
                "\n- _(section truncated to budget — read `.mimori/memory.md`)_"
            used = limit
        else:
            break

    out = [preamble] if preamble else []
    for idx, (heading, body) in enumerate(sections):
        out.append(f"{heading}\n{kept[idx]}".rstrip() if idx in kept
                   else f"{heading}\n- _(section trimmed to budget — read `.mimori/memory.md`)_")
    dropped = len(sections) - len(kept)
    if dropped:
        out.append(f"_{dropped} of {len(sections)} sections trimmed, lowest-priority first "
                   f"(invariants and gotchas are kept ahead of status)._")
    return "\n\n".join(out)


def resolve_budget(value: Optional[str], default: int) -> int:
    """Accept a raw character count or a preset name; env var sets the session default."""
    raw = value or os.environ.get("MIMORI_BUDGET") or os.environ.get("AGENT_CTX_BUDGET") or "default"
    if raw == "default":
        return default
    if raw.isdigit():
        return int(raw)
    if raw in BUDGET_PRESETS:
        return BUDGET_PRESETS[raw]
    names = "/".join(["default", *BUDGET_PRESETS])
    raise SystemExit(f"--budget: expected a character count or one of {names}, got {raw!r}")


def resolve_focus(value: Optional[str]) -> List[str]:
    """Comma-separated focus tokens from flag or env (MIMORI_FOCUS / AGENT_CTX_FOCUS)."""
    raw = value or os.environ.get("MIMORI_FOCUS") or os.environ.get("AGENT_CTX_FOCUS") or ""
    return [t.strip() for t in raw.split(",") if t.strip()]


def cmd_init(args: argparse.Namespace) -> int:
    root = find_repo_root()
    ensure_git_repo(root)
    mimori_dir = get_mimori_dir(root)
    mimori_dir.mkdir(exist_ok=True)

    for name, template in (("memory.md", DEFAULT_MEMORY_TEMPLATE), ("decisions.md", DEFAULT_DECISIONS_TEMPLATE)):
        target = mimori_dir / name
        if not target.exists():
            target.write_text(template, encoding="utf-8")
            print(f"Created {target.relative_to(root)}")
        else:
            print(f"Already exists: {target.relative_to(root)}")

    act_file = mimori_dir / "activity.jsonl"
    if not act_file.exists():
        act_file.touch()
        print(f"Created {act_file.relative_to(root)}")

    map_file = mimori_dir / "repo_map.md"
    map_file.write_text(generate_repo_map(root), encoding="utf-8")
    print(f"Generated {map_file.relative_to(root)}")
    print("Initialization complete.")
    return 0


def cmd_map(args: argparse.Namespace) -> int:
    root = find_repo_root()
    map_content = generate_repo_map(root, budget=resolve_budget(args.budget, MAP_BUDGET_DEFAULT),
                                    focus=resolve_focus(getattr(args, "focus", None)))

    if args.stdout:
        print(map_content)
    else:
        mimori_dir = get_mimori_dir(root)
        mimori_dir.mkdir(exist_ok=True)
        map_file = mimori_dir / "repo_map.md"
        map_file.write_text(map_content, encoding="utf-8")
        print(f"Updated {map_file.relative_to(root)}")
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    root = find_repo_root()
    mimori_dir = get_mimori_dir(root)
    mimori_dir.mkdir(exist_ok=True)
    act_file = mimori_dir / "activity.jsonl"

    files_list = [f.strip() for f in args.files.split(",") if f.strip()] if args.files else []
    record = {
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "action": args.action,
        "summary": args.summary,
        "files": files_list,
        "branch": get_git_branch(root),
        "author": os.environ.get("AGENT_NAME", "agent"),
    }

    with open(act_file, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")
    print(f"Logged action '{args.action}' to {act_file.relative_to(root)}")
    if len(args.summary) > ACTIVITY_SUMMARY_LIMIT:
        print(f"Note: summary is {len(args.summary)} chars — dump's Recent Activity elides past "
              f"{ACTIVITY_SUMMARY_LIMIT}. Keep it a high-level one-liner (what changed and why it "
              f"matters); save step-by-step detail for the commit message.")
    print("Reminder: if this introduced a new invariant, gotcha, or architecture decision, update .mimori/memory.md or .mimori/decisions.md.")
    return 0


def cmd_history(args: argparse.Namespace) -> int:
    root = find_repo_root()
    mimori_dir = get_mimori_dir(root)
    act_file = mimori_dir / "activity.jsonl"
    if not act_file.is_file():
        print("No activity recorded yet.")
        return 0

    lines = act_file.read_text(encoding="utf-8", errors="ignore").strip().splitlines()
    if not lines:
        print("No activity recorded yet.")
        return 0

    records = []
    for l in lines:
        try:
            records.append(json.loads(l))
        except Exception:
            continue

    selected = records[-args.limit:] if args.limit > 0 else records
    for r in reversed(selected):
        ts = r.get("timestamp", "")[:19].replace("T", " ")
        files = ", ".join(r.get("files", []))
        print(f"[{ts}] ({r.get('branch') or 'unknown'}) {r.get('action', '')}")
        print(f"  Summary: {r.get('summary', '')}")
        if files:
            print(f"  Files: {files}")
        print()
    return 0


def cmd_dump(args: argparse.Namespace) -> int:
    root = find_repo_root()
    ensure_git_repo(root)
    mimori_dir = get_mimori_dir(root)
    total = resolve_budget(getattr(args, "budget", None), DUMP_TOTAL_BUDGET)
    # Prose stores each get a third; the map takes what is left. Scaling with the
    # total is what makes a larger preset help every section, not just the map.
    prose_budget = total // 3

    out = [f"# Agent Context Snapshot ({root.name})\n"]

    state = get_working_state(root)
    if state:
        out.append("## Working state\n")
        out.append(state)
        out.append("\n---\n")

    mem_file = mimori_dir / "memory.md"
    if mem_file.is_file():
        out.append("## Project Memory\n")
        out.append(clip_memory(mem_file.read_text(encoding="utf-8", errors="ignore").strip(), prose_budget))
        out.append("\n---\n")

    dec_file = mimori_dir / "decisions.md"
    if dec_file.is_file():
        out.append("## Architecture Decisions\n")
        out.append(clip_decisions(dec_file.read_text(encoding="utf-8", errors="ignore").strip(), prose_budget))
        out.append("\n---\n")

    # Build the activity tail before the map so the map's share is what is genuinely
    # left over — otherwise DUMP_TOTAL_BUDGET would not be a total at all.
    tail: List[str] = []
    act_file = mimori_dir / "activity.jsonl"
    if act_file.is_file():
        lines = act_file.read_text(encoding="utf-8", errors="ignore").strip().splitlines()
        if lines:
            tail.append("## Recent Activity\n")
            entries: List[str] = []
            elided = False
            for l in lines[-5:]:
                try:
                    r = json.loads(l)
                except Exception:
                    continue
                ts = r.get("timestamp", "")[:10]
                summary = r.get("summary", "")
                if len(summary) > ACTIVITY_SUMMARY_LIMIT:
                    summary = _elide(summary, ACTIVITY_SUMMARY_LIMIT)
                    elided = True
                files = r.get("files", [])
                if len(files) > ACTIVITY_FILES_SHOWN:
                    files_str = ", ".join(files[:ACTIVITY_FILES_SHOWN]) + f", +{len(files) - ACTIVITY_FILES_SHOWN} more"
                    elided = True
                else:
                    files_str = ", ".join(files) or "none"
                entries.append(f"- **{ts} [{r.get('action')}]**: {summary} (files: {files_str})")

            # Keep the most recent entries first when the budget can't fit all of them.
            kept: List[str] = []
            used = 0
            for entry in reversed(entries):
                if used + len(entry) + 1 > DUMP_ACTIVITY_BUDGET:
                    break
                kept.append(entry)
                used += len(entry) + 1
            dropped = len(entries) - len(kept)
            kept.reverse()
            tail.extend(kept)
            if dropped or elided:
                tail.append(f"_{len(kept)} of {len(entries)} entries shown"
                             f"{', some elided' if elided else ''} — read `.mimori/activity.jsonl`._")

    spent = sum(len(chunk) for chunk in out) + sum(len(chunk) for chunk in tail)
    out.append("## Structure & Symbol Map (live)\n")
    out.append(generate_repo_map(root, budget=max(DUMP_MAP_MIN_BUDGET, total - spent),
                                 focus=resolve_focus(getattr(args, "focus", None))).strip())
    out.append("\n---\n")
    out.extend(tail)

    rendered = "\n".join(out)

    out_target = getattr(args, "file", None)
    if out_target is not None:
        if out_target == "" or out_target is True or out_target is None or isinstance(out_target, bool):
            commit_id = get_repo_identifier(root)
            temp_dir = get_user_temp_dir()
            prune_user_temp_dir(temp_dir, current_repo=root.name)
            dest_file = temp_dir / f"ctx-{root.name}-{commit_id}.md"
        else:
            dest_file = Path(out_target).resolve()
            dest_file.parent.mkdir(parents=True, exist_ok=True)

        dest_file.write_text(rendered, encoding="utf-8")
        print(f"Wrote context snapshot to {dest_file}")
        return 0

    print(rendered)
    return 0


def cmd_clean(args: argparse.Namespace) -> int:
    temp_dir = get_user_temp_dir()
    if not temp_dir.is_dir():
        print(f"Mimori cache directory {temp_dir} does not exist.")
        return 0

    if getattr(args, "all", False):
        deleted = 0
        freed = 0
        for p in temp_dir.glob("ctx-*.md"):
            try:
                sz = p.stat().st_size
                p.unlink(missing_ok=True)
                deleted += 1
                freed += sz
            except OSError:
                pass
        print(f"Cleared all cached snapshots: {deleted} files removed ({format_bytes(freed)} freed) from {temp_dir}")
        return 0

    pruned_count, pruned_bytes = prune_user_temp_dir(temp_dir)
    print(f"Pruned stale snapshots: {pruned_count} files removed ({format_bytes(pruned_bytes)} freed) from {temp_dir}")
    return 0


