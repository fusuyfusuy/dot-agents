def build_python_index(paths: Set[str]) -> Dict[str, Set[str]]:
    """Map every dotted-path suffix of each module to the file(s) providing it.

    So `backend/db.py` is reachable as "db", "backend.db", ... which lets an
    `from backend.db import X` in a src-layout project resolve without knowing
    where sys.path would have started.
    """
    index: Dict[str, Set[str]] = {}
    for path in paths:
        if not path.endswith(".py"):
            continue
        parts = path[:-3].split("/")
        if parts[-1] == "__init__":
            parts = parts[:-1]
        if not parts:
            continue
        for i in range(len(parts)):
            index.setdefault(".".join(parts[i:]), set()).add(path)
    return index


def _resolve_py_module(module: str, index: Dict[str, Set[str]]) -> Optional[str]:
    hits = index.get(module)
    if hits and len(hits) == 1:  # ambiguous names would create false edges
        return next(iter(hits))
    return None


_JSONC_RE = re.compile(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/', re.S)


def _load_jsonc(path: Path) -> dict:
    """Parse JSON that may carry comments/trailing commas (tsconfig.json does)."""
    raw = path.read_text(encoding="utf-8", errors="ignore")
    try:
        return json.loads(raw)
    except Exception:
        pass
    stripped = _JSONC_RE.sub(lambda m: m.group(0) if m.group(0).startswith('"') else "", raw)
    return json.loads(re.sub(r",\s*([}\]])", r"\1", stripped))


def load_path_aliases(root: Path, paths: Set[str]) -> List[Tuple[str, List[str]]]:
    """(prefix, [target dirs]) from tsconfig/jsconfig `compilerOptions.paths`.

    Without this, an aliased project's import graph is nearly empty: in a typical
    Next.js repo `@/...` imports outnumber relative ones by more than 10:1.
    """
    aliases: List[Tuple[str, List[str]]] = []
    for cfg in ("tsconfig.json", "jsconfig.json"):
        if cfg not in paths:
            continue
        try:
            opts = _load_jsonc(root / cfg).get("compilerOptions") or {}
        except Exception:
            continue
        base_dir = os.path.normpath(str(opts.get("baseUrl") or "."))
        for pattern, targets in (opts.get("paths") or {}).items():
            prefix = pattern.replace("*", "")
            if not prefix:
                continue
            dirs = [os.path.normpath(f"{base_dir}/{str(t).replace('*', '')}") for t in targets]
            aliases.append((prefix, dirs))
    return aliases


def _try_candidates(norm: str, paths: Set[str]) -> Optional[str]:
    if norm.startswith(".."):
        return None
    for cand in [norm] + [norm + e for e in JS_EXTS] + [f"{norm}/index{e}" for e in JS_EXTS]:
        if cand in paths:
            return cand
    return None


def _resolve_rel_path(source: str, spec: str, paths: Set[str]) -> Optional[str]:
    try:
        norm = os.path.normpath((Path(source).parent / spec).as_posix())
    except Exception:
        return None
    return _try_candidates(norm, paths)


def _resolve_alias(spec: str, aliases: List[Tuple[str, List[str]]], paths: Set[str]) -> Optional[str]:
    for prefix, dirs in aliases:
        if not spec.startswith(prefix):
            continue
        rest = spec[len(prefix):]
        for target_dir in dirs:
            hit = _try_candidates(os.path.normpath(f"{target_dir}/{rest}"), paths)
            if hit:
                return hit
    return None


def parse_go_module(root: Path, paths: Set[str]) -> Optional[str]:
    if "go.mod" not in paths:
        return None
    try:
        content = (root / "go.mod").read_text(encoding="utf-8", errors="ignore")
        m = re.search(r"^module\s+([^\s\n]+)", content, re.MULTILINE)
        return m.group(1) if m else None
    except OSError:
        return None


def parse_cargo_crate(root: Path, paths: Set[str]) -> Optional[str]:
    if "Cargo.toml" not in paths:
        return None
    try:
        content = (root / "Cargo.toml").read_text(encoding="utf-8", errors="ignore")
        m = re.search(r'name\s*=\s*["\']([^"\']+)["\']', content)
        return m.group(1) if m else None
    except OSError:
        return None


def compute_pagerank(infos: Dict[str, FileInfo], damping: float = 0.85, iters: int = 30) -> Dict[str, float]:
    """File-level vectorized PageRank on import graph using contiguous flat arrays (pure stdlib)."""
    nodes = list(infos.keys())
    n = len(nodes)
    if n == 0:
        return {}
    if n == 1:
        return {nodes[0]: 1.0}

    node_to_idx = {name: i for i, name in enumerate(nodes)}
    out_degree = array.array("i", [0] * n)
    in_edges: List[array.array] = [array.array("i") for _ in range(n)]

    for src_name, info in infos.items():
        src_idx = node_to_idx.get(src_name)
        if src_idx is None:
            continue
        valid_deps = [node_to_idx[d] for d in info.depends_on if d in node_to_idx]
        out_degree[src_idx] = len(valid_deps)
        for dst_idx in valid_deps:
            in_edges[dst_idx].append(src_idx)

    inv_n = 1.0 / n
    rank = array.array("d", [inv_n] * n)
    new_rank = array.array("d", [0.0] * n)

    for _ in range(iters):
        dangling_sum = sum(rank[i] for i in range(n) if out_degree[i] == 0)
        base = (1.0 - damping) * inv_n + (damping * dangling_sum) * inv_n

        delta = 0.0
        for i in range(n):
            s = base
            for src in in_edges[i]:
                s += damping * (rank[src] / out_degree[src])
            new_rank[i] = s
            delta += abs(s - rank[i])

        rank[:] = new_rank
        if delta < 1e-7:
            break

    return {nodes[i]: rank[i] for i in range(n)}


class _GraphCtx:
    """Shared resolution context passed to spec resolvers."""
    __slots__ = ("paths", "py_index", "aliases", "go_mod", "cargo_crate")

    def __init__(self, paths: Set[str], py_index: Dict[str, Set[str]],
                 aliases: List[Tuple[str, List[str]]], go_mod: Optional[str],
                 cargo_crate: Optional[str]):
        self.paths = paths
        self.py_index = py_index
        self.aliases = aliases
        self.go_mod = go_mod
        self.cargo_crate = cargo_crate


def _resolve_py_abs_spec(spec: tuple, source: str, ctx: _GraphCtx) -> List[str]:
    hit = _resolve_py_module(spec[1], ctx.py_index)
    return [hit] if hit else []


def _resolve_py_rel_spec(spec: tuple, source: str, ctx: _GraphCtx) -> List[str]:
    _, level, module = spec
    base = Path(source).parent
    for _ in range(level - 1):
        base = base.parent
    stem = (base / module.replace(".", "/")).as_posix().lstrip("./")
    for cand in (f"{stem}.py", f"{stem}/__init__.py"):
        if cand in ctx.paths:
            return [cand]
    return []


def _resolve_js_spec(spec: tuple, source: str, ctx: _GraphCtx) -> List[str]:
    js_spec = spec[1]
    if js_spec.startswith("."):
        hit = _resolve_rel_path(source, js_spec, ctx.paths)
    else:
        hit = _resolve_alias(js_spec, ctx.aliases, ctx.paths)
    return [hit] if hit else []


def _resolve_go_spec(spec: tuple, source: str, ctx: _GraphCtx) -> List[str]:
    # Go packages fan out: one import edge per .go file under the package dir.
    go_spec = spec[1]
    if not (ctx.go_mod and go_spec.startswith(ctx.go_mod)):
        return []
    sub = go_spec[len(ctx.go_mod):].lstrip("/")
    return [c for c in ctx.paths
            if c.startswith(sub + "/") and c.endswith(".go") and c != source]


def _resolve_rs_mod_spec(spec: tuple, source: str, ctx: _GraphCtx) -> List[str]:
    mod_name = spec[1]
    src_parent = Path(source).parent.as_posix().lstrip("./")
    prefix = f"{src_parent}/" if src_parent and src_parent != "." else ""
    for cand in (f"{prefix}{mod_name}.rs", f"{prefix}{mod_name}/mod.rs", f"src/{mod_name}.rs", f"src/{mod_name}/mod.rs"):
        norm = os.path.normpath(cand)
        if norm in ctx.paths and norm != source:
            return [norm]
    return []


def _resolve_rs_use_spec(spec: tuple, source: str, ctx: _GraphCtx) -> List[str]:
    use_path = spec[1]
    if not use_path.startswith("crate::"):
        return []
    parts = use_path[7:].split("::")
    stem = "/".join(parts)
    for cand in (f"src/{stem}.rs", f"src/{stem}/mod.rs", f"{stem}.rs", f"{stem}/mod.rs"):
        norm = os.path.normpath(cand)
        if norm in ctx.paths and norm != source:
            return [norm]
    return []


def _resolve_rb_req_spec(spec: tuple, source: str, ctx: _GraphCtx) -> List[str]:
    rb_spec = spec[1]
    if rb_spec.startswith("."):
        hit = _resolve_rel_path(source, rb_spec, ctx.paths) or _resolve_rel_path(source, rb_spec + ".rb", ctx.paths)
        return [hit] if hit else []
    for cand in (f"{rb_spec}.rb", f"lib/{rb_spec}.rb", f"app/{rb_spec}.rb", f"{rb_spec}"):
        norm = os.path.normpath(cand)
        if norm in ctx.paths and norm != source:
            return [norm]
    return []


_SPEC_RESOLVERS = {
    "py_abs": _resolve_py_abs_spec,
    "py_rel": _resolve_py_rel_spec,
    "js_spec": _resolve_js_spec,
    "go_spec": _resolve_go_spec,
    "rs_mod": _resolve_rs_mod_spec,
    "rs_use": _resolve_rs_use_spec,
    "rb_req": _resolve_rb_req_spec,
}


def build_import_graph(infos: Dict[str, FileInfo], py_index: Dict[str, Set[str]],
                       aliases: List[Tuple[str, List[str]]],
                       go_mod: Optional[str] = None,
                       cargo_crate: Optional[str] = None) -> None:
    """Populate `importers` so in-degree can rank structurally central modules.

    Resolves Python (via ast), JS/TS (relative & tsconfig aliases), Go (via go.mod),
    and Rust (via Cargo.toml / mod.rs / crate:: paths) through _SPEC_RESOLVERS;
    each resolver returns candidate target paths for a single import spec.
    """
    ctx = _GraphCtx(set(infos), py_index, aliases, go_mod, cargo_crate)
    for source, info in infos.items():
        for spec in info.imports:
            resolver = _SPEC_RESOLVERS.get(spec[0])
            if resolver is None:
                _debug(f"unknown import spec tag {spec[0]!r} in {source}")
                continue
            for target in resolver(spec, source, ctx):
                if target != source and target in infos:
                    infos[target].importers.add(source)
                    info.depends_on.add(target)

