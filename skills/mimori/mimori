# --------------------------------------------------------------------------

PROSE_DATA_EXTS = {
    ".md", ".mdx", ".txt", ".rst", ".adoc", ".json", ".jsonl",
    ".csv", ".tsv", ".lock", ".svg", ".png", ".jpg", ".jpeg",
    ".gif", ".ico", ".pdf", ".zip", ".tar", ".gz"
}

RE_STRICT_PONYTAIL = re.compile(r"""^[ \t]*(?:#|//|/\*|<!--|\*)[ \t]*ponytail:[ \t]*(.*)""", re.I)
RE_LOOSE_PONYTAIL = re.compile(r"""\bponytail:[ \t]*(.*)""", re.I)
RE_COMMENT_LINE = re.compile(r"^[ \t]*(?:#|//|/\*|\*|<!--|\"\"\"|''')[ \t]*(.*)")


class DebtItem:
    """Represents one in-code ponytail debt marker."""

    def __init__(self, file: str, lineno: int, raw_text: str, what: str, ceiling: str, trigger: str, has_trigger: bool):
        self.file = file
        self.lineno = lineno
        self.raw_text = raw_text
        self.what = what
        self.ceiling = ceiling
        self.trigger = trigger
        self.has_trigger = has_trigger
        self.duplicates: List[str] = []

    @property
    def location(self) -> str:
        return f"{self.file}:{self.lineno}"

    def format_line(self) -> str:
        dup_tag = f" [duplicate x{len(self.duplicates) + 1}]" if self.duplicates else ""
        trig_tag = "" if self.has_trigger else " [no-trigger]"
        # Omit redundant ceiling: 'X <- X -> Y' is ledger noise when ceiling repeats what.
        mid = f" <- {self.ceiling}" if self.ceiling and self.ceiling != self.what else ""
        return f"{self.location}: {self.what}{mid} -> {self.trigger or 'unspecified'}{trig_tag}{dup_tag}"


def _has_valid_trigger(trigger_text: str) -> bool:
    """Evaluate if trigger names a concrete condition, threshold, dependency, or owner."""
    t = trigger_text.strip().lower()
    if not t or t in ("deferred", "todo", "later", "fix later", "eventually", "tbd", "none", "unknown"):
        return False
    trigger_words = ("when", "if", "after", "once", "supports", "threshold", "until", "owner", "dep", "requires", "blocked", "target", ">", "<", ">=", "<=", "@")
    if any(w in t for w in trigger_words):
        return True
    if any(ch.isdigit() for ch in t):
        return True
    return len(t) >= 12


def scan_ponytail_debt(root: Path, files: Optional[List[str]] = None) -> List[DebtItem]:
    """Scan workspace for ponytail: deferral comments with 2-pass analysis and multi-line context."""
    if files is None:
        files = list_files(root)

    items: List[DebtItem] = []
    seen_locations: Set[Tuple[str, int]] = set()

    for rel in files:
        full = root / rel
        ext = Path(rel).suffix.lower()
        try:
            content = full.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue

        lines = content.splitlines()
        for i, line in enumerate(lines):
            loc = (rel, i + 1)
            if loc in seen_locations:
                continue

            m_strict = RE_STRICT_PONYTAIL.match(line)
            m_loose = RE_LOOSE_PONYTAIL.search(line) if (ext not in PROSE_DATA_EXTS) else None

            if not m_strict:
                if not m_loose:
                    continue
                s_line = line.strip()
                if s_line.startswith(('"', "'", 'f"', "f'", 'r"', "r'", 'b"', "b'", "RE_", "const ", "let ", "var ", "assert ", "print(", "help=", "description=", "-", "* **", "**")):
                    continue
                if "re.compile" in line or ("_test" in rel and rel != "debt_test"):
                    continue
                prefix = line[:m_loose.start()].strip()
                if not (prefix.startswith(("#", "//", "/*", "<!--")) or prefix == "*"):
                    continue

            seen_locations.add(loc)
            first_match_text = (m_strict.group(1) if m_strict else m_loose.group(1)).strip()

            comment_parts = [first_match_text]
            for j in range(i + 1, min(len(lines), i + 8)):
                next_line = lines[j]
                if not next_line.strip():
                    break
                m_next_comment = RE_COMMENT_LINE.match(next_line)
                if not m_next_comment:
                    break
                if "ponytail:" in next_line.lower():
                    break
                comment_parts.append(m_next_comment.group(1).strip())

            full_comment = " ".join(p for p in comment_parts if p).strip()
            full_comment = re.sub(r'(\*/|-->|"""|\'\'\')\s*$', '', full_comment).strip()

            what, ceiling, trigger = "", "", ""
            if "<-" in full_comment and "->" in full_comment:
                p1 = full_comment.split("<-", 1)
                what = p1[0].strip()
                p2 = p1[1].split("->", 1)
                ceiling = p2[0].strip()
                trigger = p2[1].strip()
            elif "ceiling:" in full_comment.lower() and "upgrade" in full_comment.lower():
                m_c = re.search(r'ceiling:\s*([^,;.]+)', full_comment, re.I)
                m_u = re.search(r'upgrade(?: path)?:\s*([^,;.]+)', full_comment, re.I)
                ceiling = m_c.group(1).strip() if m_c else ""
                trigger = m_u.group(1).strip() if m_u else ""
                what = full_comment.split("ceiling:")[0].strip().rstrip(",;")
            elif "," in full_comment:
                # comma format is "what, upgrade trigger when..." — there is no ceiling in this style
                parts = full_comment.split(",", 1)
                what = parts[0].strip()
                ceiling = ""
                trigger = parts[1].strip()
            else:
                what = full_comment
                ceiling = full_comment
                trigger = ""

            has_trig = _has_valid_trigger(trigger)
            items.append(DebtItem(rel, i + 1, full_comment, what, ceiling, trigger, has_trig))

    key_to_items: Dict[str, List[DebtItem]] = {}
    for item in items:
        norm_key = re.sub(r'[^a-zA-Z0-9]', '', item.what.lower())
        if norm_key:
            key_to_items.setdefault(norm_key, []).append(item)

    for group in key_to_items.values():
        if len(group) > 1:
            files_in_group = list({it.file for it in group})
            if len(files_in_group) > 1:
                for it in group:
                    it.duplicates = [f for f in files_in_group if f != it.file]

    return items


def cmd_debt(args: argparse.Namespace) -> int:
    root = find_repo_root()
    action = getattr(args, "action", "list") or "list"
    plain = getattr(args, "plain", False) or not sys.stdout.isatty()
    use_color = not plain

    if action == "list":
        items = scan_ponytail_debt(root)
        if not items:
            print("No ponytail: debt. Clean ledger.")
            return 0

        bold = "\033[1m" if use_color else ""
        reset = "\033[0m" if use_color else ""
        yellow = "\033[33m" if use_color else ""
        red = "\033[31m" if use_color else ""
        cyan = "\033[36m" if use_color else ""
        dim = "\033[2m" if use_color else ""

        print(f"{bold}# Ponytail Debt Ledger ({len(items)} markers){reset}\n")
        no_trig_count = 0
        dup_count = 0

        for it in items:
            loc = f"{cyan}{it.location}{reset}"
            what_str = f"{bold}{it.what}{reset}"
            ceiling_str = f"{dim}ceiling:{reset} {it.ceiling}" if it.ceiling else ""
            trig_str = f"{dim}upgrade:{reset} {it.trigger}" if it.trigger else ""
            tags = []
            if not it.has_trigger:
                tags.append(f"{red}[no-trigger]{reset}")
                no_trig_count += 1
            if it.duplicates:
                tags.append(f"{yellow}[duplicate x{len(it.duplicates) + 1}]{reset}")
                dup_count += 1
            tag_str = " " + " ".join(tags) if tags else ""

            print(f"- {loc}: {what_str}{tag_str}")
            if ceiling_str or trig_str:
                details = " · ".join(d for d in (ceiling_str, trig_str) if d)
                print(f"    {details}")

        print(f"\n{dim}{len(items)} markers, {no_trig_count} no-trigger, {dup_count} duplicated.{reset}")
        return 0

    elif action == "check":
        items = scan_ponytail_debt(root)
        errors: List[str] = []
        for it in items:
            if not it.has_trigger:
                errors.append(f"{it.location}: Missing concrete upgrade trigger ({it.trigger!r})")
        if errors:
            print(f"Error: {len(errors)} ponytail: debt marker(s) failed check:")
            for err in errors:
                print(f"  - {err}")
            return 1
        print(f"All {len(items)} ponytail: debt markers verified with valid triggers.")
        return 0

    elif action == "sync":
        mimori_dir = get_mimori_dir(root)
        mem_file = mimori_dir / "memory.md"
        if not mem_file.is_file():
            print("Error: .mimori/memory.md not found. Run 'mimori init' first.")
            return 1

        mem_text = mem_file.read_text(encoding="utf-8", errors="ignore")
        items = scan_ponytail_debt(root)

        lines = mem_text.splitlines()
        debt_start = -1
        debt_end = len(lines)

        for idx, line in enumerate(lines):
            if re.match(r"^##\s+KNOWN\s+DEBT", line, re.I):
                debt_start = idx
            elif debt_start != -1 and re.match(r"^##\s+", line):
                debt_end = idx
                break

        manual_entries: List[str] = []
        if debt_start != -1:
            for l in lines[debt_start + 1:debt_end]:
                l_strip = l.strip()
                if l_strip.startswith("- accepted") or l_strip.startswith("* accepted"):
                    manual_entries.append(l_strip)

        new_debt_lines = ["## KNOWN DEBT", ""]
        new_debt_lines.extend(manual_entries)
        for it in items:
            mid = f" <- {it.ceiling}" if it.ceiling and it.ceiling != it.what else ""
            new_debt_lines.append(f"- {it.file}:{it.lineno}: {it.what}{mid} -> {it.trigger or 'unspecified'}")

        if len(new_debt_lines) > 32:
            new_debt_lines = new_debt_lines[:32]

        if debt_start != -1:
            updated_lines = lines[:debt_start] + new_debt_lines + lines[debt_end:]
        else:
            updated_lines = lines + ["", "---", ""] + new_debt_lines

        atomic_write_text(mem_file, "\n".join(updated_lines) + "\n", encoding="utf-8")
        print(f"Synchronized {len(items)} ponytail debt markers into .mimori/memory.md (## KNOWN DEBT).")
        return 0

    return 0


