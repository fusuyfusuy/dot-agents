def _resolve_target_file_and_symbol(target: str, infos: Dict[str, FileInfo]) -> Tuple[Optional[FileInfo], Optional[str]]:
    f_tok, sym_tok = target.split(":", 1) if ":" in target else (target, None)
    f_tok = f_tok.strip()
    sym_tok = sym_tok.strip() if sym_tok else None

    if f_tok in infos:
        return infos[f_tok], sym_tok

    matches = [i for i in infos.values() if i.path == f_tok or i.path.endswith(f"/{f_tok}") or Path(i.path).name == f_tok]
    if matches:
        return matches[0], sym_tok

    if sym_tok is None and f_tok:
        for i in infos.values():
            for _, _, txt in i.symbols:
                if f_tok in txt:
                    return i, f_tok
    return None, None


def _find_symbol_range(full_path: Path, sym_token: Optional[str], info: FileInfo) -> Tuple[int, int, Optional[str]]:
    if not sym_token:
        return 1, info.lines or 1, None

    if full_path.suffix == ".py" and full_path.exists():
        with contextlib.suppress(Exception):
            tree = ast.parse(full_path.read_text(encoding="utf-8", errors="ignore"))
            for node in ast.walk(tree):
                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and (node.name == sym_token or sym_token in node.name):
                    start = node.lineno
                    end = getattr(node, "end_lineno", start + 30)
                    sig = f"class {node.name}" if isinstance(node, ast.ClassDef) else _fmt_signature(node, drop_self=False)
                    return start, end, sig

    for lineno, _, txt in info.symbols:
        if sym_token.lower() in txt.lower():
            return lineno, min(lineno + 30, info.lines or lineno + 30), txt
    return 1, info.lines or 1, None


def _render_slice_code(full_path: Path, start: int, end: int, max_lines: int) -> List[str]:
    if not full_path.exists() or full_path.is_dir():
        return ["(file not found on disk)"]
    try:
        lines = full_path.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError as e:
        return [f"(error reading file: {e})"]
    total = len(lines)
    start = max(1, min(start, total))
    end = min(total, max(start, end))
    if (end - start + 1) > max_lines:
        end = start + max_lines - 1
    out = [f"{str(idx).rjust(5)}: {lines[idx - 1]}" for idx in range(start, end + 1)]
    if end < total and (end - start + 1) >= max_lines:
        out.append(f"       ... +{total - end} more lines (clipped to {max_lines} lines)")
    return out


def generate_slice(root: Path, target: str, max_lines: int = 100) -> str:
    infos = collect_repo(root)
    info, sym_token = _resolve_target_file_and_symbol(target, infos)
    if not info:
        return f"Error: Target '{target}' not found in repository."

    full_path = root / info.path
    start, end, sym_text = _find_symbol_range(full_path, sym_token, info)

    out = [
        f"# Slice: `{info.path}`" + (f" (symbol: `{sym_token}`)" if sym_token else ""),
        f"- **Coordinates**: lines {start}–{end} ({info.lines} total lines)",
    ]
    if info.importers:
        callers = sorted({_importer_label(p) for p in info.importers})
        out.append(f"- **Ancestors (In-Degree {info.in_degree})**: " + ", ".join(f"`{c}`" for c in callers))
    else:
        out.append("- **Ancestors (In-Degree 0)**: (entry point / root)")

    if info.depends_on:
        deps = sorted({_importer_label(p) for p in info.depends_on})
        out.append(f"- **Dependencies (Out-Degree {len(info.depends_on)})**: " + ", ".join(f"`{d}`" for d in deps))

    if info.doc:
        out.append(f"- **Doc**: \"{info.doc}\"")
    if sym_text:
        out.append(f"- **Contract**: `{sym_text}`")

    ext = full_path.suffix.lstrip(".") or "text"
    out.extend(["", f"```{ext}"])
    out.extend(_render_slice_code(full_path, start, end, max_lines))
    out.append("```")
    return "\n".join(out)


