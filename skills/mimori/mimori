        )
        remaining_count = len(list(temp_dir.glob("ctx-*.md")))
        assert remaining_count == 5, f"expected 5 files remaining after max_files=5, got {remaining_count}"


def run_self_test() -> int:
    with tempfile.TemporaryDirectory() as tmpdir:
        root = Path(tmpdir).resolve()
        _build_fixture(root)
        _test_symbols_and_graph(root)
        _test_budget_is_honest(root)
        _test_log_summary_length(root)
        _test_activity_tail(root)
        _test_focus(root)
        _test_misc(root)
        _test_git_integration(root)
        _test_dump_is_live(root)
        _test_dump_file_and_git_init(root)
        _test_cache_pruning(root)
    print("Self-test passed successfully.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="mimori", description="Zero-daemon Agent Context, Memory, & Activity Tracker")
    parser.add_argument("--test", action="store_true", help="Run self-tests and exit")
    subparsers = parser.add_subparsers(dest="command", help="Sub-command to execute")

    subparsers.add_parser("init", help="Initialize .mimori/ directory with templates and repo map")

    map_parser = subparsers.add_parser("map", help="Scan repository and generate ranked symbol map")
    map_parser.add_argument("--stdout", action="store_true", help="Print map to stdout instead of file")
    budget_help = (f"Character budget: a number, 'default', or {'/'.join(BUDGET_PRESETS)} "
                   f"({', '.join(f'{k}={v}' for k, v in BUDGET_PRESETS.items())}). "
                   f"Env: MIMORI_BUDGET.")
    map_parser.add_argument("--budget", default=None, help=budget_help)
    focus_help = ("Comma-separated files/substrings to pull into full detail with their "
                  "import-graph neighbors; everything else collapses. Env: MIMORI_FOCUS.")
    map_parser.add_argument("--focus", default=None, help=focus_help)

    dump_parser = subparsers.add_parser(
        "dump", help="Print high-signal context snapshot (state, memory, decisions, map, activity)")
    dump_parser.add_argument("--budget", default=None, help=budget_help)
    dump_parser.add_argument("--focus", default=None,
                             help="Comma-separated files/substrings to pull into full detail "
                                  "(with their import-graph neighbors); env: MIMORI_FOCUS.")
    dump_parser.add_argument(
        "--file", "-o", "--out",
        nargs="?",
        const="",
        default=None,
        help="Write snapshot to user temp file ($XDG_RUNTIME_DIR/mimori/ctx-<repo>-<commit>.md) or custom path",
    )

    log_parser = subparsers.add_parser("log", help="Append an entry to .mimori/activity.jsonl")
    log_parser.add_argument("--action", required=True, help="Short action name (e.g. 'feature-auth')")
    log_parser.add_argument("--summary", required=True, help="Detailed summary of change and rationale")
    log_parser.add_argument("--files", default="", help="Comma-separated list of modified files")

    hist_parser = subparsers.add_parser("history", help="Show recent logged agent actions")
    hist_parser.add_argument("--limit", type=int, default=10, help="Number of records to show (default: 10)")

    clean_parser = subparsers.add_parser("clean", help="Clean stale or expired context snapshots from user temp directory")
    clean_parser.add_argument("--all", action="store_true", help="Remove all cached context snapshots unconditionally")

    args = parser.parse_args()

    if args.test:
        return run_self_test()

    if not args.command:
        parser.print_help()
        return 1

    handlers = {
        "init": cmd_init,
        "map": cmd_map,
        "dump": cmd_dump,
        "log": cmd_log,
        "history": cmd_history,
        "clean": cmd_clean,
    }
    return handlers[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
