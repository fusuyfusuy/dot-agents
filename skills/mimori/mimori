def _split_sections(text: str) -> Tuple[str, List[Tuple[str, str]]]:
    """Split markdown into (preamble, [(heading, body)]) at its dominant heading level.

    The level is detected rather than assumed: real files disagree with the template
    (titirek writes `## ADR-001: ...`, this repo writes `### [date] Title`).
    """
    lines = text.splitlines()
    # A heading inside an HTML comment is documentation, not a record: the shipped
    # templates show the record format that way, and it must not parse as an entry.
    visible, in_comment = [], False
    for line in lines:
        visible.append(not in_comment)
        if "<!--" in line and "-->" not in line:
            in_comment = True
        elif in_comment and "-->" in line:
            in_comment = False

    counts = {lv: sum(1 for i, l in enumerate(lines)
                      if visible[i] and re.match(rf"^#{{{lv}}}\s+\S", l)) for lv in (2, 3, 4)}
    level = max(counts, key=lambda lv: (counts[lv], -lv))
    if counts[level] == 0:
        return text, []

    pat = re.compile(rf"^#{{{level}}}\s+\S")
    preamble: List[str] = []
    sections: List[List] = []
    for i, line in enumerate(lines):
        if visible[i] and pat.match(line):
            sections.append([line, []])
        elif sections:
            sections[-1][1].append(line)
        else:
            preamble.append(line)
    return "\n".join(preamble).strip(), [(h, "\n".join(b).rstrip()) for h, b in sections]


def _is_superseded(section: Tuple[str, str]) -> bool:
    """An ADR that names its replacement is history, not current guidance."""
    heading, body = section
    return "superseded by" in body.lower() or "[superseded]" in heading.lower()


def clip_decisions(text: str, limit: int) -> str:
    """Keep every ADR *title*, expand bodies newest-first until the budget runs out.

    Positional clipping is wrong for ADRs: they are not news, and the oldest entries
    are usually the load-bearing invariants. Titles cost ~60 chars each, so the full
    list of decisions stays visible indefinitely and any body can still be read from
    the file.
    """
    preamble, sections = _split_sections(text)
    if not sections:
        return text

    live = [i for i in range(len(sections)) if not _is_superseded(sections[i])]
    if len(live) == len(sections) and len(text) <= limit:
        return text

    used = len(preamble) + sum(len(h) + 2 for h, _ in sections) + 160
    expanded = set()
    for idx in reversed(live):  # newest live entries are appended last
        body = sections[idx][1]
        if used + len(body) + 2 > limit:
            continue
        used += len(body) + 2
        expanded.add(idx)

    out = [preamble] if preamble else []
    for idx, (heading, body) in enumerate(sections):
        if idx in expanded:
            out.append(f"{heading}\n{body}".rstrip())
        elif idx not in live:
            out.append(f"{heading}\n- _(superseded — kept for history, read `.mimori/decisions.md`)_")
        else:
            out.append(f"{heading}\n- _(body trimmed to budget — read `.mimori/decisions.md`)_")
    hidden = len(sections) - len(expanded)
    if hidden:
        superseded = len(sections) - len(live)
        note = f"_{hidden} of {len(sections)} decisions shown by title only"
        if superseded:
            note += f" ({superseded} superseded)"
        out.append(note + "; no decision is hidden entirely._")
    return "\n\n".join(out)


MEMORY_PRIORITY = (
    ("invariant", "rule", "architecture", "constraint"),
    ("gotcha", "vocab", "domain", "glossar", "edge"),
)


def _memory_priority(heading: str) -> int:
    low = heading.lower()
    for rank, keywords in enumerate(MEMORY_PRIORITY):
        if any(k in low for k in keywords):
            return rank
    return len(MEMORY_PRIORITY)  # epics/status: the most perishable, trimmed first


def clip_memory(text: str, limit: int) -> str:
    """Trim by section priority, not file position.

    Invariants and gotchas outlive "active epics", but epics sit first in the
    template — clipping from the top keeps the changelog and drops the durable rules.
    """
    preamble, sections = _split_sections(text)
    if not sections or len(text) <= limit:
        return text

    order = sorted(range(len(sections)), key=lambda i: (_memory_priority(sections[i][0]), i))
    used = len(preamble) + sum(len(sections[i][0]) + 2 for i in range(len(sections))) + 160
    kept: Dict[int, str] = {}
    for i in order:
        body = sections[i][1]
        room = limit - used
        if len(body) + 2 <= room:
            kept[i] = body
            used += len(body) + 2
        elif room > 300:
            # Partially include rather than skip: a greedy fill would drop the single
            # most valuable section whenever it is the largest, and backfill with
            # lower-priority ones. Priority has to dominate size.
            cut = body[:room - 90]
            kept[i] = cut[:cut.rfind("\n") if "\n" in cut else len(cut)].rstrip() + \
                "\n- _(section truncated to budget — read `.mimori/memory.md`)_"
            used = limit
        else:
            break

    out = [preamble] if preamble else []
    for idx, (heading, body) in enumerate(sections):
        out.append(f"{heading}\n{kept[idx]}".rstrip() if idx in kept
                   else f"{heading}\n- _(section trimmed to budget — read `.mimori/memory.md`)_")
    dropped = len(sections) - len(kept)
    if dropped:
        out.append(f"_{dropped} of {len(sections)} sections trimmed, lowest-priority first "
                   f"(invariants and gotchas are kept ahead of status)._")
    return "\n\n".join(out)


