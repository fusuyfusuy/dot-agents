# task / todo / idea tracking
# --------------------------------------------------------------------------

RE_TASK_LINE = re.compile(r"^(\s*[-*]\s+)\[([ xX/\\?-])\]\s*(.*)$")
RE_DATE = re.compile(r"\b\((\d{4}-\d{2}-\d{2})\)\s*$")
RE_PRIO = re.compile(r"\b\((high|med|low|urgent|p[0-3])\)\b", re.IGNORECASE)
RE_TAG = re.compile(r"\[([a-zA-Z0-9_\-]+)\]")

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None and os.environ.get("TERM") != "dumb"


def colorize(text: str, code: str, plain: bool = False) -> str:
    if plain or not USE_COLOR or not code:
        return text
    return f"\033[{code}m{text}\033[0m"


class TaskItem:
    def __init__(
        self,
        raw_line: str,
        section_idx: int,
        section_name: str,
        status: str,
        text: str,
        prio: Optional[str] = None,
        tags: Optional[List[str]] = None,
        completed_date: Optional[str] = None,
    ):
        self.raw_line = raw_line
        self.section_idx = section_idx
        self.section_name = section_name
        self.status = status  # 'in_progress', 'todo', 'idea', 'done'
        self.text = text
        self.prio = prio
        self.tags = tags or []
        self.completed_date = completed_date
        self.index: int = 0


def parse_tasks_document(content: str) -> Tuple[str, List[Tuple[str, List[TaskItem | str]]]]:
    preamble, raw_sections = _split_sections(content)
    sections: List[Tuple[str, List[TaskItem | str]]] = []

    for s_idx, (heading, body) in enumerate(raw_sections):
        head_low = heading.lower()
        items: List[TaskItem | str] = []
        for line in body.splitlines():
            line_str = line.strip()
            if not line_str:
                continue
            m = RE_TASK_LINE.match(line)
            if m:
                box = m.group(2)
                rest = m.group(3).strip()

                if box in ("x", "X"):
                    status = "done"
                elif box in ("/", "-", "\\"):
                    status = "in_progress"
                elif box == "?":
                    status = "idea"
                else:
                    if "in progress" in head_low or "in-progress" in head_low or "current" in head_low:
                        status = "in_progress"
                    elif "idea" in head_low or "backlog" in head_low:
                        status = "idea"
                    elif "complete" in head_low or "done" in head_low:
                        status = "done"
                    else:
                        status = "todo"

                completed_date = None
                d_match = RE_DATE.search(rest)
                if d_match:
                    completed_date = d_match.group(1)
                    rest = (rest[:d_match.start()] + " " + rest[d_match.end():]).strip()

                prio = None
                p_match = RE_PRIO.search(rest)
                if p_match:
                    prio = p_match.group(1).lower()
                    rest = (rest[:p_match.start()] + " " + rest[p_match.end():]).strip()

                tags = RE_TAG.findall(rest)
                clean_text = RE_TAG.sub("", rest).strip()
                clean_text = re.sub(r"\s+", " ", clean_text)

                item = TaskItem(
                    raw_line=line,
                    section_idx=s_idx,
                    section_name=heading,
                    status=status,
                    text=clean_text or rest,
                    prio=prio,
                    tags=tags,
                    completed_date=completed_date,
                )
                items.append(item)
            elif line_str.startswith(("- ", "* ")) and not line_str.startswith(("- (", "* (")):
                clean_bullet = line_str[2:].strip()
                if "in progress" in head_low:
                    status = "in_progress"
                elif "idea" in head_low or "backlog" in head_low:
                    status = "idea"
                elif "complete" in head_low or "done" in head_low:
                    status = "done"
                else:
                    status = "todo"
                item = TaskItem(
                    raw_line=line,
                    section_idx=s_idx,
                    section_name=heading,
                    status=status,
                    text=clean_bullet,
                )
                items.append(item)
            else:
                items.append(line)
        sections.append((heading, items))

    return preamble, sections


def get_all_tasks(sections: List[Tuple[str, List[TaskItem | str]]]) -> List[TaskItem]:
    all_tasks: List[TaskItem] = []
    idx = 1
    for heading, items in sections:
        for it in items:
            if isinstance(it, TaskItem):
                it.index = idx
                idx += 1
                all_tasks.append(it)
    return all_tasks


def serialize_tasks_document(preamble: str, sections: List[Tuple[str, List[TaskItem | str]]]) -> str:
    out = []
    if preamble.strip():
        out.append(preamble.strip())

    for heading, items in sections:
        out.append("")
        out.append(heading.strip())
        for it in items:
            if isinstance(it, str):
                if it.strip():
                    out.append(it)
            else:
                box = (
                    "[x]" if it.status == "done"
                    else "[/]" if it.status == "in_progress"
                    else "[?]" if it.status == "idea"
                    else "[ ]"
                )
                prio_str = f"({it.prio}) " if it.prio else ""
                tags_str = "".join(f"[{t}] " for t in it.tags)
                date_str = f" ({it.completed_date})" if it.completed_date and it.status == "done" else ""
                out.append(f"- {box} {prio_str}{tags_str}{it.text}{date_str}".strip())

    return "\n".join(out).strip() + "\n"


def find_matching_task(all_tasks: List[TaskItem], query: str) -> Tuple[Optional[TaskItem], Optional[str]]:
    query = query.strip()
    if not query:
        return None, "No task identifier or search term specified."

    num_str = query.lstrip("#")
    if num_str.isdigit():
        target_idx = int(num_str)
        for t in all_tasks:
            if t.index == target_idx:
                return t, None
        return None, f"Task #{target_idx} not found."

    q_low = query.lower()
    exact_matches = [t for t in all_tasks if t.text.lower() == q_low]
    if len(exact_matches) == 1:
        return exact_matches[0], None

    sub_matches = [
        t for t in all_tasks
        if q_low in t.text.lower() or any(q_low in tag.lower() for tag in t.tags)
    ]
    if len(sub_matches) == 1:
        return sub_matches[0], None
    elif len(sub_matches) > 1:
        active = [t for t in sub_matches if t.status != "done"]
        if len(active) == 1:
            return active[0], None
        return None, f"Ambiguous query '{query}' matched {len(sub_matches)} tasks. Please specify an exact task ID (e.g. #{sub_matches[0].index})."

    return None, f"No task matching '{query}' found."


def ensure_task_section(sections: List[Tuple[str, List[TaskItem | str]]], target_type: str) -> int:
    for idx, (heading, _) in enumerate(sections):
        low = heading.lower()
        if target_type == "in_progress" and ("in progress" in low or "in-progress" in low or "current" in low):
            return idx
        if target_type == "active" and ("active" in low or "todo" in low or "pending" in low):
            return idx
        if target_type == "ideas" and ("idea" in low or "backlog" in low or "future" in low):
            return idx
        if target_type == "completed" and ("complete" in low or "done" in low or "finished" in low):
            return idx

    heading_map = {
        "in_progress": "## In Progress",
        "active": "## Active Tasks",
        "ideas": "## Future Ideas & Backlog",
        "completed": "## Completed",
    }
    new_heading = heading_map.get(target_type, f"## {target_type.title()}")
    sections.append((new_heading, []))
    return len(sections) - 1


def clip_tasks(text: str, limit: int) -> str:
    """Smart priority budgeting for tasks in context snapshots (mimori dump)."""
    preamble, sections = parse_tasks_document(text)
    if not sections:
        return text

    in_progress_items: List[TaskItem] = []
    active_items: List[TaskItem] = []
    idea_items: List[TaskItem] = []
    done_items: List[TaskItem] = []

    for heading, items in sections:
        for it in items:
            if isinstance(it, TaskItem):
                if it.status == "in_progress":
                    in_progress_items.append(it)
                elif it.status == "idea":
                    idea_items.append(it)
                elif it.status == "done":
                    done_items.append(it)
                else:
                    active_items.append(it)

    out_sections: List[str] = []
    used = 100

    if in_progress_items:
        lines = ["### In Progress"]
        for it in in_progress_items:
            prio = f"({it.prio}) " if it.prio else ""
            tags = "".join(f"[{t}] " for t in it.tags)
            lines.append(f"- [/] {prio}{tags}{it.text}".strip())
        block = "\n".join(lines)
        out_sections.append(block)
        used += len(block) + 2

    if active_items:
        lines = ["### Active Tasks"]
        kept_active = 0
        for it in active_items:
            prio = f"({it.prio}) " if it.prio else ""
            tags = "".join(f"[{t}] " for t in it.tags)
            line = f"- [ ] {prio}{tags}{it.text}".strip()
            if used + len(line) + 2 > limit and kept_active > 0:
                break
            lines.append(line)
            used += len(line) + 2
            kept_active += 1
        if kept_active < len(active_items):
            lines.append(f"- _({len(active_items) - kept_active} more active tasks trimmed to budget — read `.mimori/tasks.md`)_")
        out_sections.append("\n".join(lines))

    if idea_items and used < limit - 100:
        lines = ["### Future Ideas & Backlog"]
        kept_ideas = 0
        for it in idea_items:
            tags = "".join(f"[{t}] " for t in it.tags)
            line = f"- [?] {tags}{it.text}".strip()
            if used + len(line) + 2 > limit and kept_ideas > 0:
                break
            lines.append(line)
            used += len(line) + 2
            kept_ideas += 1
        if kept_ideas < len(idea_items):
            lines.append(f"- _({len(idea_items) - kept_ideas} ideas trimmed to budget — read `.mimori/tasks.md`)_")
        out_sections.append("\n".join(lines))
    elif idea_items:
        out_sections.append(f"### Future Ideas & Backlog\n- _({len(idea_items)} backlog ideas trimmed to budget — read `.mimori/tasks.md`)_")

    if done_items:
        recent_done = done_items[-2:] if (limit - used > 300) else []
        lines = ["### Completed"]
        for it in recent_done:
            date_str = f" ({it.completed_date})" if it.completed_date else ""
            lines.append(f"- [x] {it.text}{date_str}")
        hidden_done = len(done_items) - len(recent_done)
        if hidden_done > 0:
            lines.append(f"- _({hidden_done} completed task{'s' if hidden_done > 1 else ''} hidden — read `.mimori/tasks.md`)_")
        out_sections.append("\n".join(lines))

    return "\n\n".join(out_sections)


def resolve_budget(value: Optional[str], default: int) -> int:
    """Accept a raw character count or a preset name; env var sets the session default."""
    raw = value or os.environ.get("MIMORI_BUDGET") or os.environ.get("AGENT_CTX_BUDGET") or "default"
    if raw == "default":
        return default
    if raw.isdigit():
        return int(raw)
    if raw in BUDGET_PRESETS:
        return BUDGET_PRESETS[raw]
    names = "/".join(["default", *BUDGET_PRESETS])
    raise SystemExit(f"--budget: expected a character count or one of {names}, got {raw!r}")


def resolve_focus(value: Optional[str]) -> List[str]:
    """Comma-separated focus tokens from flag or env (MIMORI_FOCUS / AGENT_CTX_FOCUS)."""
    raw = value or os.environ.get("MIMORI_FOCUS") or os.environ.get("AGENT_CTX_FOCUS") or ""
    return [t.strip() for t in raw.split(",") if t.strip()]


