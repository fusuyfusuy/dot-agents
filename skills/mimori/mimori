def find_repo_root(start: Optional[Path] = None) -> Path:
    curr = (start or Path.cwd()).resolve()
    for parent in [curr] + list(curr.parents):
        if (parent / ".git").exists() or (parent / ".mimori").exists() or (parent / "mimori").exists() or (parent / ".agents").exists():
            return parent
    return curr


def get_mimori_dir(root: Path) -> Path:
    if (root / ".mimori").exists():
        return root / ".mimori"
    if (root / "mimori").exists():
        return root / "mimori"
    if (root / ".agents").exists():
        return root / ".agents"
    return root / ".mimori"


def ensure_git_repo(root: Path) -> bool:
    """Initializes a git repo if .git is missing."""
    if not (root / ".git").exists():
        try:
            res = subprocess.run(["git", "init"], cwd=str(root), capture_output=True, text=True, check=False)
            if res.returncode == 0:
                print(f"Initialized empty Git repository in {root}")
                return True
        except Exception:
            pass
    return False


def get_repo_identifier(root: Path) -> str:
    """Returns 7-char short commit hash, 'init' for empty repos, or short UUID."""
    out = run_git(root, "rev-parse", "--short=7", "HEAD", timeout=2)
    if out and out.strip():
        return out.strip()
    if (root / ".git").exists():
        return "init"
    return uuid.uuid4().hex[:7]


def get_user_temp_dir() -> Path:
    """Resolves user-isolated temp directory: $XDG_RUNTIME_DIR/mimori or /tmp/mimori-$UID."""
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR")
    if xdg_runtime and os.path.isdir(xdg_runtime):
        base = Path(xdg_runtime) / "mimori"
    else:
        uid = os.getuid() if hasattr(os, "getuid") else "user"
        tmp = os.environ.get("TMPDIR", "/tmp")
        base = Path(tmp) / f"mimori-{uid}"
    base.mkdir(parents=True, exist_ok=True, mode=0o700)
    return base


def format_bytes(num: int) -> str:
    """Format byte size into human readable string."""
    val = float(num)
    for unit in ("B", "KB", "MB", "GB"):
        if abs(val) < 1024.0:
            return f"{val:3.1f} {unit}" if unit != "B" else f"{int(val)} B"
        val /= 1024.0
    return f"{val:.1f} TB"


def prune_user_temp_dir(
    temp_dir: Optional[Path] = None,
    current_repo: Optional[str] = None,
    max_per_repo: Optional[int] = None,
    ttl_hours: Optional[float] = None,
    max_files: Optional[int] = None,
    now: Optional[float] = None,
) -> Tuple[int, int]:
    """Prunes stale snapshot files from temp_dir according to retention policies.

    Enforces:
      1. Global age TTL (default: 72h).
      2. Per-repo LRU retention (default: keep newest 2 per repo).
      3. Global max files cap (default: keep newest 50 files total).

    Returns (pruned_count, pruned_bytes).
    """
    if temp_dir is None:
        temp_dir = get_user_temp_dir()
    if not temp_dir.is_dir():
        return 0, 0

    if max_per_repo is None:
        try:
            max_per_repo = int(os.environ.get("MIMORI_CACHE_MAX_PER_REPO", DEFAULT_CACHE_MAX_PER_REPO))
        except ValueError:
            max_per_repo = DEFAULT_CACHE_MAX_PER_REPO

    if ttl_hours is None:
        try:
            ttl_hours = float(os.environ.get("MIMORI_CACHE_TTL_HOURS", DEFAULT_CACHE_TTL_HOURS))
        except ValueError:
            ttl_hours = DEFAULT_CACHE_TTL_HOURS

    if max_files is None:
        try:
            max_files = int(os.environ.get("MIMORI_CACHE_MAX_FILES", DEFAULT_CACHE_MAX_FILES))
        except ValueError:
            max_files = DEFAULT_CACHE_MAX_FILES

    now_ts = time.time() if now is None else now
    ttl_seconds = ttl_hours * 3600.0

    pruned_count = 0
    pruned_bytes = 0

    try:
        entries: List[Tuple[Path, float, int]] = []
        for p in temp_dir.glob("ctx-*.md"):
            if not p.is_file():
                continue
            try:
                stat = p.stat()
                entries.append((p, stat.st_mtime, stat.st_size))
            except OSError:
                continue

        to_delete: Set[Path] = set()
        file_sizes = {p: sz for p, _, sz in entries}

        # 1. Global age TTL
        if ttl_seconds > 0:
            for p, mtime, _ in entries:
                if (now_ts - mtime) > ttl_seconds:
                    to_delete.add(p)

        # 2. Per-repo retention (ctx-<repo>-<commit>.md)
        repo_groups: Dict[str, List[Tuple[Path, float]]] = {}
        for p, mtime, _ in entries:
            if p in to_delete:
                continue
            name = p.stem
            if name.startswith("ctx-"):
                parts = name[4:].rsplit("-", 1)
                repo_name = parts[0] if len(parts) == 2 else name[4:]
                repo_groups.setdefault(repo_name, []).append((p, mtime))

        if max_per_repo > 0:
            for r_name, r_files in repo_groups.items():
                r_files.sort(key=lambda x: x[1], reverse=True)
                for p, _ in r_files[max_per_repo:]:
                    to_delete.add(p)

        # 3. Global max files ceiling
        remaining = [e for e in entries if e[0] not in to_delete]
        if max_files > 0 and len(remaining) > max_files:
            remaining.sort(key=lambda x: x[1])
            excess = len(remaining) - max_files
            for p, _, _ in remaining[:excess]:
                to_delete.add(p)

        # Perform deletions
        for p in to_delete:
            try:
                sz = file_sizes.get(p, 0)
                p.unlink(missing_ok=True)
                pruned_count += 1
                pruned_bytes += sz
            except OSError:
                pass
    except Exception:
        pass

    return pruned_count, pruned_bytes


def run_git(root: Path, *args: str, timeout: int = 5) -> Optional[str]:
    """Run a git command in `root`. Returns stdout, or None if git/repo is unavailable."""
    try:
        res = subprocess.run(
            ["git", "-C", str(root), *args],
            capture_output=True, text=True, timeout=timeout, check=False,
        )
    except Exception:
        return None
    if res.returncode != 0:
        return None
    return res.stdout


def get_git_branch(root: Path) -> Optional[str]:
    """Current branch name, "detached@<sha>" on detached HEAD, or None outside git.

    Never guesses a branch name: a fabricated value would be written into the
    permanent activity log.
    """
    out = run_git(root, "rev-parse", "--abbrev-ref", "HEAD", timeout=2)
    if out is None or not out.strip():
        return None
    branch = out.strip()
    if branch == "HEAD":
        sha = run_git(root, "rev-parse", "--short", "HEAD", timeout=2)
        return f"detached@{sha.strip()}" if sha and sha.strip() else "detached"
    return branch


def should_ignore(rel_path: Path) -> bool:
    return any(part in DEFAULT_IGNORES for part in rel_path.parts)


def list_files(root: Path) -> List[str]:
    """Repo-visible files as posix-relative strings.

    Delegates to `git ls-files` so .gitignore semantics (negations, path-scoped
    patterns, globs) are git's problem, not ours. Falls back to a walk with a
    fixed ignore list outside git checkouts.
    """
    out = run_git(root, "ls-files", "--cached", "--others", "--exclude-standard", "-z", timeout=15)
    if out is not None:
        rels = {p for p in out.split("\0") if p}
        return sorted(r for r in rels if (root / r).is_file())

    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = Path(dirpath).relative_to(root)
        dirnames[:] = [d for d in dirnames if not should_ignore(rel_dir / d)]
        for f in filenames:
            rel = rel_dir / f if rel_dir != Path(".") else Path(f)
            if not should_ignore(rel) and not f.endswith(".pyc"):
                found.append(rel.as_posix())
    return sorted(found)


def get_churn(root: Path, days: int = CHURN_DAYS) -> Dict[str, int]:
    """Commits touching each file in the recent window. Empty dict outside git."""
    out = run_git(root, "log", f"--since={days}.days", "-n", "400", "--name-only",
                  "--pretty=format:", timeout=10)
    if not out:
        return {}
    counts: Dict[str, int] = {}
    for line in out.splitlines():
        line = line.strip()
        if line:
            counts[line] = counts.get(line, 0) + 1
    return counts


def get_working_state(root: Path) -> Optional[str]:
    """Branch, uncommitted files and recent commits — what a resuming agent needs first."""
    branch = get_git_branch(root)
    if branch is None:
        return None

    lines = [f"- branch: `{branch}`"]

    status = run_git(root, "status", "--porcelain")
    dirty = [l for l in (status or "").splitlines() if l.strip()]
    if dirty:
        lines.append(f"- uncommitted ({len(dirty)}):")
        for entry in dirty[:10]:
            lines.append(f"    - `{entry.strip()}`")
        if len(dirty) > 10:
            lines.append(f"    - ... and {len(dirty) - 10} more")
    else:
        lines.append("- uncommitted: none (clean tree)")

    log = run_git(root, "log", "-5", "--oneline", "--no-decorate")
    if log and log.strip():
        lines.append("- recent commits:")
        for entry in log.strip().splitlines():
            lines.append(f"    - {entry}")
    return "\n".join(lines)


